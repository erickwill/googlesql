    +-query=
      +-ProjectScan
        +-column_list=[$aggregate.$agg1#4]
        +-input_scan=
          +-AggregateScan
            +-column_list=[$aggregate.$agg1#4]
            +-input_scan=
            | +-WithRefScan(column_list=[t.inner_row#3], with_query_name="t")
            +-aggregate_list=
              +-$agg1#4 :=
                +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
