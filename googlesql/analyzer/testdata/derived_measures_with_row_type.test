# Scenario: Query both normal and derived measures from the same nested row type.
SELECT AGG(row_type_col.inner_row_col.measure_sum_price),
       AGG(row_type_col.inner_row_col.measure_derived_sum_price_plus_one)
FROM tvf_returning_nested_row_with_derived_type();
