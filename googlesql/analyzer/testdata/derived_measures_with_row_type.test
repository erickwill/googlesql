# Scenario: Query derived measure from a nested row type projected in a CTE.
WITH t AS (
  SELECT row_type_col.inner_row_col AS inner_row
  FROM tvf_returning_nested_row_with_derived_type()
)
SELECT AGG(inner_row.measure_derived_sum_price_plus_one) FROM t;
