    +-column_list=[$aggregate.$agg1#4]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=[t.inner_row#2]
    |       +-expr_list=
    |       | +-inner_row#2 :=
    |       |   +-GetRowField
    |       |     +-type=ROW<MeasureTable_Derived>
    |       |     +-expr=
