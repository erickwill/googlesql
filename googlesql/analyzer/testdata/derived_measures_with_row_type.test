# Scenario 1: AGG(rk.m) for derived measures
# Verifies that a GetRowField returning a derived measure inside an aggregate function (AGG)
# is replaced by a MakeStruct closure and aggregated properly.
#
# We can't run sqlbuilder for measures from rows because the rewritten ASTs
# are unparsed to `IF(row IS NULL, ..., ...)`, which fails resolution because
# we currently do not allow row-typed arguments.
[default no_java]
[default no_run_deserializer]
[default no_run_sqlbuilder]
[default language_features=MAXIMUM,+ENABLE_MEASURES,+ROW_TYPE,+MEASURES_IN_STRUCT,+DERIVED_MEASURE]
[default enabled_ast_rewrites=DEFAULTS,+MEASURE_TYPE,+ROW_TYPE]
SELECT normal_col_1, AGG(row_type_col.measure_derived_sum_price_plus_one)
FROM tvf_returning_derived_measure_row_type()
GROUP BY normal_col_1;
--
QueryStmt
+-output_column_list=
| +-$groupby.normal_col_1#4 AS normal_col_1 [STRING]
| +-$aggregate.$agg1#3 AS `$col2` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.normal_col_1#4, $aggregate.$agg1#3]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.normal_col_1#4, $aggregate.$agg1#3]
        +-input_scan=
        | +-TVFScan(column_list=tvf_returning_derived_measure_row_type.[normal_col_1#1, row_type_col#2], tvf=tvf_returning_derived_measure_row_type, signature=() -> TABLE<normal_col_1 STRING, row_type_col ROW<MeasureTable_Derived>> (table: table_for_tvf_returning_derived_measure_row_type), column_index_list=[0, 1], function_call_signature=() -> ANY TABLE)
        +-group_by_list=
        | +-normal_col_1#4 := ColumnRef(type=STRING, column=tvf_returning_derived_measure_row_type.normal_col_1#1)
        +-aggregate_list=
          +-$agg1#3 :=
            +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
              +-GetRowField
                +-type=MEASURE<INT64>
                +-expr=
                | +-ColumnRef(type=ROW<MeasureTable_Derived>, column=tvf_returning_derived_measure_row_type.row_type_col#2)
                +-column=MeasureTable_Derived.measure_derived_sum_price_plus_one

