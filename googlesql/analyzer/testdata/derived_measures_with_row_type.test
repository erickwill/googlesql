# Scenario 3: CTE alias for derived measure in row type
WITH t AS (
  SELECT row_type_col.measure_derived_sum_price_plus_one AS m_col
  FROM tvf_returning_derived_measure_row_type()
)
SELECT AGG(m_col) FROM t;
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#5 AS `$col1` [INT64]
+-query=
  +-WithScan
    +-column_list=[$aggregate.$agg1#5]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=[t.m_col#3]
    |       +-expr_list=
    |       | +-m_col#3 :=
    |       |   +-GetRowField
    |       |     +-type=MEASURE<INT64>
    |       |     +-expr=
    |       |     | +-ColumnRef(type=ROW<MeasureTable_Derived>, column=tvf_returning_derived_measure_row_type.row_type_col#2)
    |       |     +-column=MeasureTable_Derived.measure_derived_sum_price_plus_one
    |       +-input_scan=
    |         +-TVFScan(column_list=[tvf_returning_derived_measure_row_type.row_type_col#2], tvf=tvf_returning_derived_measure_row_type, signature=() -> TABLE<normal_col_1 STRING, row_type_col ROW<MeasureTable_Derived>> (table: table_for_tvf_returning_derived_measure_row_type), column_index_list=[1], function_call_signature=() -> ANY TABLE)
    +-query=
      +-ProjectScan
        +-column_list=[$aggregate.$agg1#5]
        +-input_scan=
          +-AggregateScan
            +-column_list=[$aggregate.$agg1#5]
            +-input_scan=
            | +-WithRefScan(column_list=[t.m_col#4], with_query_name="t")
            +-aggregate_list=
              +-$agg1#5 :=
                +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
                  +-ColumnRef(type=MEASURE<INT64>, column=t.m_col#4)

