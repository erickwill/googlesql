| +-ConnectionList
|   +-connection=
|     +-Connection(connection=connection1)
+-output_column_list=
| +-$create_as.a#2 AS a [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$create_as.a#2]
    +-expr_list=
    | +-a#2 := Literal(type=INT64, value=1)
    +-input_scan=
      +-SingleRowScan
==

