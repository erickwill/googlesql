[no_enable_literal_replacement]
CREATE LIVE TABLE queryless_collate (a INT64, b STRING) DEFAULT COLLATE 'und:ci';
--
CreateLiveTableStmt
+-name_path=queryless_collate
+-column_definition_list=
| +-ColumnDefinition(name="a", type=INT64, column=queryless_collate.a#1)
| +-ColumnDefinition(name="b", type=STRING, column=queryless_collate.b#2)
+-collation_name=
  +-Literal(type=STRING, value="und:ci")
==


# 6. Queryless Primary Key validation
CREATE LIVE TABLE queryless_pk (a INT64, PRIMARY KEY(a));
--
CreateLiveTableStmt
+-name_path=queryless_pk
+-column_definition_list=
| +-ColumnDefinition(name="a", type=INT64, column=queryless_pk.a#1)
+-primary_key=
  +-PrimaryKey(column_offset_list=[0], column_name_list=[a])
