[default no_java]
[default no_run_deserializer]
[default no_run_sqlbuilder]
[default language_features=MAXIMUM,+ENABLE_MEASURES,+ROW_TYPE,+DERIVED_MEASURE,+MEASURES_IN_STRUCT,+ANNOTATION_FRAMEWORK,+COLLATION_SUPPORT,+TIMESTAMP_PRECISION_ANNOTATION]
[default enabled_ast_rewrites=DEFAULTS,+MEASURE_TYPE,-ROW_TYPE]
# Test Case 1: Collation propagation on measure inside row type (from TVF)
SELECT normal_col_1, AGG(row_type_col.measure_ci)
FROM tvf_returning_annotated_measure_row_type()
GROUP BY normal_col_1;
--
QueryStmt
+-output_column_list=
| +-$groupby.normal_col_1#4 AS normal_col_1 [STRING]
| +-$aggregate.$agg1#3{Collation:"und:ci"} AS `$col2` [STRING]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.normal_col_1#4, $aggregate.$agg1#3{Collation:"und:ci"}]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.normal_col_1#4, $aggregate.$agg1#3{Collation:"und:ci"}]
        +-input_scan=
        | +-TVFScan(column_list=tvf_returning_annotated_measure_row_type.[normal_col_1#1, row_type_col#2], tvf=tvf_returning_annotated_measure_row_type, signature=() -> TABLE<normal_col_1 STRING, row_type_col ROW<MeasureTable_SingleKey_WithAnnotations>> (table: table_for_tvf_returning_annotated_measure_row_type), column_index_list=[0, 1], function_call_signature=() -> ANY TABLE)
        +-group_by_list=
        | +-normal_col_1#4 := ColumnRef(type=STRING, column=tvf_returning_annotated_measure_row_type.normal_col_1#1)
        +-aggregate_list=
          +-$agg1#3 :=
            +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<STRING>) -> STRING)
              +-type_annotation_map={Collation:"und:ci"}
              +-GetRowField
                +-type=MEASURE<STRING>
                +-type_annotation_map=<{Collation:"und:ci"}>
                +-expr=
                | +-ColumnRef(type=ROW<MeasureTable_SingleKey_WithAnnotations>, column=tvf_returning_annotated_measure_row_type.row_type_col#2)
                +-column=MeasureTable_SingleKey_WithAnnotations.measure_ci

