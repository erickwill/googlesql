# Row type measure propagation through scalar subquery
FROM tvf_returning_annotated_measure_row_type() AS t
|> SELECT (SELECT t.row_type_col) AS r2, normal_col_1
|> AGGREGATE AGG(r2.measure_ci) GROUP BY normal_col_1;
--
QueryStmt
+-output_column_list=
| +-$groupby.normal_col_1#6 AS normal_col_1 [STRING]
| +-$aggregate.$agg1#5{Collation:"und:ci"} AS `$col1` [STRING]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.normal_col_1#6, $aggregate.$agg1#5{Collation:"und:ci"}]
    +-input_scan=
    | +-ProjectScan
    |   +-column_list=[$pipe_select.r2#4, tvf_returning_annotated_measure_row_type.normal_col_1#1]
    |   +-expr_list=
    |   | +-r2#4 :=
    |   |   +-SubqueryExpr
    |   |     +-type=ROW<MeasureTable_SingleKey_WithAnnotations>
    |   |     +-subquery_type=SCALAR
    |   |     +-parameter_list=
    |   |     | +-ColumnRef(type=ROW<MeasureTable_SingleKey_WithAnnotations>, column=tvf_returning_annotated_measure_row_type.row_type_col#2)
    |   |     +-subquery=
    |   |       +-ProjectScan
    |   |         +-column_list=[$expr_subquery.row_type_col#3]
    |   |         +-expr_list=
    |   |         | +-row_type_col#3 := ColumnRef(type=ROW<MeasureTable_SingleKey_WithAnnotations>, column=tvf_returning_annotated_measure_row_type.row_type_col#2, is_correlated=TRUE)
    |   |         +-input_scan=
    |   |           +-SingleRowScan
    |   +-input_scan=
    |     +-TVFScan(column_list=tvf_returning_annotated_measure_row_type.[normal_col_1#1, row_type_col#2], tvf=tvf_returning_annotated_measure_row_type, signature=() -> TABLE<normal_col_1 STRING, row_type_col ROW<MeasureTable_SingleKey_WithAnnotations>> (table: table_for_tvf_returning_annotated_measure_row_type), column_index_list=[0, 1], alias="t", function_call_signature=() -> ANY TABLE)
    +-group_by_list=
    | +-normal_col_1#6 := ColumnRef(type=STRING, column=tvf_returning_annotated_measure_row_type.normal_col_1#1)
    +-aggregate_list=
      +-$agg1#5 :=
        +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<STRING>) -> STRING)
          +-type_annotation_map={Collation:"und:ci"}
          +-GetRowField
            +-type=MEASURE<STRING>
            +-type_annotation_map=<{Collation:"und:ci"}>
            +-expr=
            | +-ColumnRef(type=ROW<MeasureTable_SingleKey_WithAnnotations>, column=$pipe_select.r2#4)
            +-column=MeasureTable_SingleKey_WithAnnotations.measure_ci

