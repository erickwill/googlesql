    | +-ColumnRef(type=TIMESTAMP, column=TimeseriesTable.ts_col#3)
    +-period=
    | +-FunctionCall(GoogleSQL:$interval(INT64, ENUM<googlesql.functions.DateTimestampPart>) -> INTERVAL)
    |   +-Literal(type=INT64, value=1)
    |   +-Literal(type=ENUM<googlesql.functions.DateTimestampPart>, value=MINUTE)
    +-origin=
    | +-FunctionCall(GoogleSQL:timestamp(STRING, optional(0) STRING) -> TIMESTAMP)
    |   +-Literal(type=STRING, value="2000-01-01")
    +-output_within=
    | +-WithinBounds
    |   +-lower_bound=
    |   | +-WithinBoundExpr(within_bound_kind=PERIOD PRECEDING)
    |   |   +-Literal(type=DOUBLE, value=1.5)
    |   +-upper_bound=
    |     +-WithinBoundExpr(within_bound_kind=PERIOD FOLLOWING)
    |       +-Literal(type=DOUBLE, value=2.5)
    +-aligned_timestamp_column=$align.aligned_timestamp#6
==

FROM TimeseriesTableWithTimestampColumn
|> ALIGN (
  TIMESTAMP timestamp + INTERVAL 1 MINUTE AS ts_col
  PERIOD INTERVAL 1 MINUTE
  ORIGIN TIMESTAMP('2000-01-01')
  METRICS SUM(requests) WITHIN (1 PERIOD PRECEDING) AS t1,
          SUM(aligned_timestamp - timestamp) WITHIN (1 PERIOD FOLLOWING) AS t2
)
--
QueryStmt
+-output_column_list=
| +-$align.t1#9 AS t1 [INT64]
| +-$align.t2#11 AS t2 [INTERVAL]
| +-$align.aligned_timestamp#7 AS ts_col [TIMESTAMP]
+-query=
  +-ProjectScan
    +-column_list=[$align.aligned_timestamp#7, $estimator.$estimator1#8, $estimator.$estimator2#10, $align.t1#9, $align.t2#11]
    +-expr_list=
    | +-t1#9 := ColumnRef(type=INT64, column=$estimator.$estimator1#8)
    | +-t2#11 := ColumnRef(type=INTERVAL, column=$estimator.$estimator2#10)
    +-input_scan=
      +-AlignScan
        +-column_list=[$align.aligned_timestamp#7, $estimator.$estimator1#8, $estimator.$estimator2#10]
        +-input_scan=
        | +-ProjectScan
        |   +-column_list=[TimeseriesTableWithTimestampColumn.timestamp#3, TimeseriesTableWithTimestampColumn.requests#5, $align.ts_col#6]
        |   +-expr_list=
        |   | +-ts_col#6 :=
        |   |   +-FunctionCall(GoogleSQL:$add(TIMESTAMP, INTERVAL) -> TIMESTAMP)
        |   |     +-ColumnRef(type=TIMESTAMP, column=TimeseriesTableWithTimestampColumn.timestamp#3)
        |   |     +-FunctionCall(GoogleSQL:$interval(INT64, ENUM<googlesql.functions.DateTimestampPart>) -> INTERVAL)
        |   |       +-Literal(type=INT64, value=1)
        |   |       +-Literal(type=ENUM<googlesql.functions.DateTimestampPart>, value=MINUTE)
        |   +-input_scan=
        |     +-TableScan(column_list=TimeseriesTableWithTimestampColumn.[timestamp#3, requests#5], table=TimeseriesTableWithTimestampColumn, column_index_list=[2, 4])
        +-timestamp_column=
        | +-ColumnRef(type=TIMESTAMP, column=$align.ts_col#6)
        +-period=
        | +-FunctionCall(GoogleSQL:$interval(INT64, ENUM<googlesql.functions.DateTimestampPart>) -> INTERVAL)
        |   +-Literal(type=INT64, value=1)
        |   +-Literal(type=ENUM<googlesql.functions.DateTimestampPart>, value=MINUTE)
        +-origin=
        | +-FunctionCall(GoogleSQL:timestamp(STRING, optional(0) STRING) -> TIMESTAMP)
        |   +-Literal(type=STRING, value="2000-01-01")
        +-output_within=
        | +-WithinBounds
        |   +-lower_bound=
        |   | +-WithinBoundExpr(within_bound_kind=UNBOUNDED PRECEDING)
        |   +-upper_bound=
        |     +-WithinBoundExpr(within_bound_kind=ANCHOR TIMESTAMP)
        +-aligned_timestamp_column=$align.aligned_timestamp#7
        +-estimator_function_list=
          +-$estimator1#8 :=
          | +-EstimatorFunctionCall(GoogleSQL:sum(INT64) -> INT64)
          |   +-ColumnRef(type=INT64, column=TimeseriesTableWithTimestampColumn.requests#5)
          |   +-within_bounds=
          |     +-WithinBounds
          |       +-lower_bound=
          |       | +-WithinBoundExpr(within_bound_kind=PERIOD PRECEDING)
          |       |   +-Literal(type=INT64, value=1)
          |       +-upper_bound=
          |         +-WithinBoundExpr(within_bound_kind=ANCHOR TIMESTAMP)
          +-$estimator2#10 :=
            +-EstimatorFunctionCall(GoogleSQL:sum(INTERVAL) -> INTERVAL)
              +-FunctionCall(GoogleSQL:$subtract(TIMESTAMP, TIMESTAMP) -> INTERVAL)
              | +-ColumnRef(type=TIMESTAMP, column=$align.aligned_timestamp#7)
              | +-ColumnRef(type=TIMESTAMP, column=$align.ts_col#6)
              +-within_bounds=
                +-WithinBounds
                  +-lower_bound=
                  | +-WithinBoundExpr(within_bound_kind=ANCHOR TIMESTAMP)
                  +-upper_bound=
                    +-WithinBoundExpr(within_bound_kind=PERIOD FOLLOWING)
                      +-Literal(type=INT64, value=1)
==

