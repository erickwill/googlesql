# Check estimator presence check works correctly even with nested ALIGN
FROM TimeseriesTable
|> ALIGN (
  TIMESTAMP ts_col
  PERIOD INTERVAL 1 MINUTE
  ORIGIN TIMESTAMP('2000-01-01')
  PARTITION BY borg_job, borg_task_num
  METRICS
    SUM((FROM TimeseriesTable
         |> ALIGN (
              TIMESTAMP ts_col
              PERIOD INTERVAL 1 MINUTE
              METRICS SUM(1) WITHIN () AS t)
        |> SELECT 1
        |> LIMIT 1)) WITHIN (1 PERIOD PRECEDING) AS b,
    SUM(1) AS c
)
--
ERROR: Aggregate function SUM not allowed in ALIGN Operator [at 15:5]
    SUM(1) AS c
    ^
