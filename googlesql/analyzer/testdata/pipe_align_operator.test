        |   +-input_scan=
        |     +-TableScan(column_list=TimeseriesTableWithTimestampColumn.[timestamp#3, requests#5], table=TimeseriesTableWithTimestampColumn, column_index_list=[2, 4])
        +-timestamp_column=
        | +-ColumnRef(type=TIMESTAMP, column=$align.ts_col#6)
        +-period=
        | +-FunctionCall(GoogleSQL:$interval(INT64, ENUM<googlesql.functions.DateTimestampPart>) -> INTERVAL)
        |   +-Literal(type=INT64, value=1)
        |   +-Literal(type=ENUM<googlesql.functions.DateTimestampPart>, value=MINUTE)
        +-origin=
        | +-FunctionCall(GoogleSQL:timestamp(STRING, optional(0) STRING) -> TIMESTAMP)
        |   +-Literal(type=STRING, value="2000-01-01")
        +-output_within=
        | +-WithinBounds
        |   +-lower_bound=
        |   | +-WithinBoundExpr(within_bound_kind=UNBOUNDED PRECEDING)
        |   +-upper_bound=
        |     +-WithinBoundExpr(within_bound_kind=ANCHOR TIMESTAMP)
        +-aligned_timestamp_column=$align.aligned_timestamp#7
        +-estimator_function_list=
          +-$estimator1#8 :=
          | +-EstimatorFunctionCall(GoogleSQL:sum(INT64) -> INT64)
          |   +-ColumnRef(type=INT64, column=TimeseriesTableWithTimestampColumn.requests#5)
          |   +-within_bounds=
          |     +-WithinBounds
          |       +-lower_bound=
          |       | +-WithinBoundExpr(within_bound_kind=PERIOD PRECEDING)
          |       |   +-Literal(type=INT64, value=1)
          |       +-upper_bound=
          |         +-WithinBoundExpr(within_bound_kind=ANCHOR TIMESTAMP)
          +-$estimator2#10 :=
            +-EstimatorFunctionCall(GoogleSQL:sum(INTERVAL) -> INTERVAL)
              +-FunctionCall(GoogleSQL:$subtract(TIMESTAMP, TIMESTAMP) -> INTERVAL)
              | +-ColumnRef(type=TIMESTAMP, column=$align.aligned_timestamp#7)
              | +-ColumnRef(type=TIMESTAMP, column=$align.ts_col#6)
              +-within_bounds=
                +-WithinBounds
                  +-lower_bound=
                  | +-WithinBoundExpr(within_bound_kind=ANCHOR TIMESTAMP)
                  +-upper_bound=
