           (measuretable_salesfacts_derived_4.a_3), STRUCT< item_id INT64 > (measuretable_salesfacts_derived_4.a_1)) AS a_5
    |> AS projectscan_6
    |> SELECT
         projectscan_6.a_1 AS a_1,
         projectscan_6.a_2 AS a_2,
         STRUCT< referenced_columns STRUCT< measure_total_price STRUCT< referenced_columns STRUCT< price INT64 >
         , key_columns STRUCT< item_id INT64 > > >, key_columns STRUCT< item_id INT64 > > (STRUCT< measure_total_price STRUCT<
           referenced_columns STRUCT< price INT64 >, key_columns STRUCT< item_id INT64 > > > (projectscan_6.a_5),
           STRUCT< item_id INT64 > (projectscan_6.a_1)) AS a_7
    |> AS projectscan_8
    |> SELECT
         projectscan_8.a_1 AS a_1,
         projectscan_8.a_2 AS a_2,
         STRUCT< m STRUCT< referenced_columns STRUCT< measure_total_price STRUCT< referenced_columns STRUCT< price INT64 >
         , key_columns STRUCT< item_id INT64 > > >, key_columns STRUCT< item_id INT64 > > > (projectscan_8.a_7) AS a_9
  )
FROM
