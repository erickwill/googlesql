FROM
  MeasureTable_Derived
|> SELECT
     MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_1
|> AS measuretable_derived_2
|> SELECT
     (
       FROM
         UNNEST(ARRAY< INT64 >[1] AS a_4)
       |> SELECT
            STRUCT(measuretable_derived_2.a_1 AS m) AS a_5
       |> AS projectscan_6
       |> AGGREGATE
            AGG(projectscan_6.a_5.m) AS a_7) AS a_3;

