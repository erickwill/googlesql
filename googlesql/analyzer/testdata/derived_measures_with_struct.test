[default no_java]
[default language_features=MAXIMUM,+MEASURES_IN_STRUCT,+DERIVED_MEASURE]
[default enabled_ast_rewrites=DEFAULTS,+MEASURE_TYPE]
[default show_sqlbuilder_output]
# 1. Struct of derived measures as columns.

## Base Case
WITH t AS (
  SELECT key, STRUCT(measure_derived_sum_price_plus_one AS m) AS s
  FROM MeasureTable_Derived
)
SELECT key, AGG(s.m) FROM t GROUP BY key;
--
QueryStmt
+-output_column_list=
| +-$groupby.key#32 AS key [INT64]
| +-$aggregate.$agg1#31 AS `$col2` [INT64]
+-query=
  +-WithScan
    +-column_list=[$groupby.key#32, $aggregate.$agg1#31]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=[MeasureTable_Derived.key#1, t.s#28]
    |       +-expr_list=
    |       | +-s#28 :=
    |       |   +-MakeStruct
    |       |     +-type=STRUCT<m MEASURE<INT64>>
    |       |     +-field_list=
    |       |       +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11)
    |       +-input_scan=
    |         +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11], table=MeasureTable_Derived, column_index_list=[0, 10])
    +-query=
      +-ProjectScan
        +-column_list=[$groupby.key#32, $aggregate.$agg1#31]
        +-input_scan=
          +-AggregateScan
            +-column_list=[$groupby.key#32, $aggregate.$agg1#31]
            +-input_scan=
            | +-WithRefScan(column_list=t.[key#29, s#30], with_query_name="t")
            +-group_by_list=
            | +-key#32 := ColumnRef(type=INT64, column=t.key#29)
            +-aggregate_list=
              +-$agg1#31 :=
                +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
                  +-GetStructField
                    +-type=MEASURE<INT64>
                    +-expr=
                    | +-ColumnRef(type=STRUCT<m MEASURE<INT64>>, column=t.s#30)
                    +-field_idx=0

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
WITH
  t AS (
    SELECT
      measuretable_derived_3.a_1 AS a_1,
      STRUCT(measuretable_derived_3.a_2 AS m) AS a_4
    FROM
      (
        SELECT
          MeasureTable_Derived.key AS a_1,
          MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_2
        FROM
          MeasureTable_Derived
      ) AS measuretable_derived_3
  )
SELECT
  withrefscan_5.a_1 AS key,
  AGG(withrefscan_5.a_4.m) AS a_7
FROM
  t AS withrefscan_5
GROUP BY 1;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
WITH
  t AS (
    FROM
      MeasureTable_Derived
    |> SELECT
         MeasureTable_Derived.key AS a_1,
         MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_2
    |> AS measuretable_derived_3
    |> SELECT
         measuretable_derived_3.a_1 AS a_1,
         STRUCT(measuretable_derived_3.a_2 AS m) AS a_4
  )
FROM
  t AS withrefscan_5
|> EXTEND
     withrefscan_5.a_1 AS a_6
|> AGGREGATE
     AGG(withrefscan_5.a_4.m) AS a_7
   GROUP BY a_6
|> AS aggregatescan_8
|> SELECT
     aggregatescan_8.a_6 AS key,
     aggregatescan_8.a_7 AS a_7;

