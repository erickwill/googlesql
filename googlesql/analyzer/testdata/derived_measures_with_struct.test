    FROM
      (
        SELECT
          projectscan_6.a_1 AS a_1,
          projectscan_6.a_2 AS a_2,
          STRUCT< referenced_columns STRUCT< measure_total_price STRUCT< referenced_columns STRUCT< price INT64 >
          , key_columns STRUCT< item_id INT64 > > >, key_columns STRUCT< item_id INT64 > > (STRUCT< measure_total_price STRUCT<
            referenced_columns STRUCT< price INT64 >, key_columns STRUCT< item_id INT64 > > > (projectscan_6.a_5),
            STRUCT< item_id INT64 > (projectscan_6.a_1)) AS a_7
        FROM
          (
            SELECT
              measuretable_salesfacts_derived_4.a_1 AS a_1,
              measuretable_salesfacts_derived_4.a_2 AS a_2,
              STRUCT< referenced_columns STRUCT< price INT64 >, key_columns STRUCT< item_id INT64 > > (STRUCT< price INT64 >
                (measuretable_salesfacts_derived_4.a_3), STRUCT< item_id INT64 > (measuretable_salesfacts_derived_4.a_1)) AS a_5
            FROM
              (
                SELECT
                  MeasureTable_SalesFacts_Derived.item_id AS a_1,
                  MeasureTable_SalesFacts_Derived.store_id AS a_2,
                  MeasureTable_SalesFacts_Derived.price AS a_3
                FROM
                  MeasureTable_SalesFacts_Derived
              ) AS measuretable_salesfacts_derived_4
          ) AS projectscan_6
      ) AS projectscan_8
  )
SELECT
  aggregatescan_17.a_15 AS item_id,
  (aggregatescan_17.a_16) + 1 AS a_18
FROM
  (
    SELECT
      projectscan_14.a_1 AS a_15,
      SUM(ANY_VALUE(projectscan_14.a_13.referenced_columns.price)
        WHERE
          NOT((projectscan_14.a_13) IS NULL)
        GROUP BY projectscan_14.a_13.key_columns.item_id) AS a_16
    FROM
      (
        SELECT
          projectscan_12.a_1 AS a_1,
          projectscan_12.a_2 AS a_2,
