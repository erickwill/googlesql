## Variation 1.1: Measure column in struct is correlated
FROM MeasureTable_Derived o
|> SELECT (
  FROM UNNEST([1])
  |> EXTEND STRUCT(o.measure_derived_sum_price_plus_one AS m) AS s
  |> AGGREGATE AGG(s.m)
)
--
QueryStmt
+-output_column_list=
| +-$pipe_select.$col1#31 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$pipe_select.$col1#31]
    +-expr_list=
    | +-$col1#31 :=
    |   +-SubqueryExpr
    |     +-type=INT64
    |     +-subquery_type=SCALAR
    |     +-parameter_list=
    |     | +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11)
    |     +-subquery=
    |       +-AggregateScan
    |         +-column_list=[$aggregate.$agg1#30]
    |         +-input_scan=
    |         | +-ProjectScan
    |         |   +-column_list=[$pipe_extend.s#29]
    |         |   +-expr_list=
    |         |   | +-s#29 :=
    |         |   |   +-MakeStruct
    |         |   |     +-type=STRUCT<m MEASURE<INT64>>
    |         |   |     +-field_list=
    |         |   |       +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11, is_correlated=TRUE)
    |         |   +-input_scan=
    |         |     +-ArrayScan
    |         |       +-array_expr_list=
    |         |       | +-Literal(type=ARRAY<INT64>, value=[1])
    |         |       +-element_column_list=[$array.$unnest1#28]
    |         +-aggregate_list=
    |           +-$agg1#30 :=
    |             +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
    |               +-GetStructField
    |                 +-type=MEASURE<INT64>
    |                 +-expr=
    |                 | +-ColumnRef(type=STRUCT<m MEASURE<INT64>>, column=$pipe_extend.s#29)
    |                 +-field_idx=0
    +-input_scan=
      +-TableScan(column_list=[MeasureTable_Derived.measure_derived_sum_price_plus_one#11], table=MeasureTable_Derived, column_index_list=[10], alias="o")

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
SELECT
  (
    SELECT
      AGG(projectscan_6.a_5.m) AS a_7
    FROM
      (
        SELECT
          STRUCT(measuretable_derived_2.a_1 AS m) AS a_5
        FROM
          UNNEST(ARRAY< INT64 >[1] AS a_4)
      ) AS projectscan_6
  ) AS a_3
FROM
  (
    SELECT
      MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_1
    FROM
      MeasureTable_Derived
  ) AS measuretable_derived_2;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
