WITH
  t AS (
    SELECT
      projectscan_7.a_1 AS a_1,
      STRUCT< m STRUCT< referenced_columns STRUCT< measure_sum_price STRUCT< referenced_columns STRUCT< price INT64 >
      , key_columns STRUCT< key INT64 > > >, key_columns STRUCT< key INT64 > > > (projectscan_7.a_6) AS a_8
    FROM
      (
        SELECT
          projectscan_5.a_1 AS a_1,
          STRUCT< referenced_columns STRUCT< measure_sum_price STRUCT< referenced_columns STRUCT< price INT64 >
          , key_columns STRUCT< key INT64 > > >, key_columns STRUCT< key INT64 > > (STRUCT< measure_sum_price STRUCT<
            referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > > (projectscan_5.a_4), STRUCT<
            key INT64 > (projectscan_5.a_1)) AS a_6
        FROM
          (
            SELECT
              measuretable_derived_3.a_1 AS a_1,
              STRUCT< referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > (STRUCT< price INT64 >
                (measuretable_derived_3.a_2), STRUCT< key INT64 > (measuretable_derived_3.a_1)) AS a_4
            FROM
              (
                SELECT
                  MeasureTable_Derived.key AS a_1,
                  MeasureTable_Derived.price AS a_2
                FROM
                  MeasureTable_Derived
              ) AS measuretable_derived_3
          ) AS projectscan_5
      ) AS projectscan_7
  )
SELECT
  aggregatescan_16.a_14 AS key,
  (aggregatescan_16.a_15) + 1 AS a_17
FROM
  (
    SELECT
      projectscan_13.a_1 AS a_14,
      SUM(ANY_VALUE(projectscan_13.a_12.referenced_columns.price)
        WHERE
          NOT((projectscan_13.a_12) IS NULL)
        GROUP BY projectscan_13.a_12.key_columns.key) AS a_15
    FROM
      (
        SELECT
          projectscan_11.a_1 AS a_1,
          projectscan_11.a_8 AS a_8,
          projectscan_11.a_10 AS a_10,
          projectscan_11.a_10.referenced_columns.measure_sum_price AS a_12
        FROM
          (
            SELECT
              withrefscan_9.a_1 AS a_1,
              withrefscan_9.a_8 AS a_8,
              withrefscan_9.a_8.m AS a_10
            FROM
              t AS withrefscan_9
          ) AS projectscan_11
      ) AS projectscan_13
    GROUP BY 1
  ) AS aggregatescan_16;

