    +-input_scan=
      +-GraphLinearScan
        +-column_list=[$graph_table.name#2]
        +-scan_list=
          +-GraphLinearScan
            +-column_list=[$graph_table.name#2]
            +-scan_list=
              +-GraphInsertScan
              | +-column_list=[$element_table.n#1]
