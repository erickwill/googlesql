# INSERT into element table with generated columns.
GRAPH aml_dml
INSERT (n:TestLabelWithGenCols {id: 1, c1: 10})
RETURN n.id, n.c1, n.gen_b, n.gen_a
--
GeneralizedQueryStmt
+-output_schema=
| +-OutputSchema
|   +-output_column_list=
|     +-$graph_table.id#2 AS id [INT64]
|     +-$graph_table.c1#3 AS c1 [INT64]
|     +-$graph_table.gen_b#4 AS gen_b [INT64]
|     +-$graph_table.gen_a#5 AS gen_a [INT64]
+-query=
  +-GraphTableScan
    +-column_list=$graph_table.[id#2, c1#3, gen_b#4, gen_a#5]
    +-property_graph=aml_dml
    +-input_scan=
      +-GraphLinearScan
        +-column_list=$graph_table.[id#2, c1#3, gen_b#4, gen_a#5]
        +-scan_list=
          +-GraphLinearScan
            +-column_list=$graph_table.[id#2, c1#3, gen_b#4, gen_a#5]
            +-scan_list=
              +-GraphInsertScan
              | +-column_list=[$element_table.n#1]
              | +-input_scan=
              | | +-SingleRowScan
              | +-insert_node_list=
              | | +-n#1 :=
              | |   +-GraphInsertElement
              | |     +-type=GRAPH_NODE(aml_dml)<c1 INT64, gen_a INT64, gen_b INT64, id INT64>
              | |     +-property_list=
              | |     | +-GraphDMLPropertyItem
              | |     | | +-property_name="id"
              | |     | | +-property=id(INT64)
              | |     | | +-property_value=
              | |     | |   +-Literal(type=INT64, value=1)
              | |     | +-GraphDMLPropertyItem
              | |     |   +-property_name="c1"
              | |     |   +-property=c1(INT64)
              | |     |   +-property_value=
              | |     |     +-Literal(type=INT64, value=10)
              | |     +-label_list=
              | |     | +-GraphLabel(label=aml_dml.TestLabelWithGenCols)
              | |     +-element_table=InsertTestTableWithGenCols
              | +-path_element_list=[$element_table.n#1]
              +-ProjectScan
                +-column_list=$graph_table.[id#2, c1#3, gen_b#4, gen_a#5]
                +-expr_list=
                | +-id#2 :=
                | | +-GraphGetElementProperty
                | |   +-type=INT64
                | |   +-expr=
                | |   | +-ColumnRef(type=GRAPH_NODE(aml_dml)<c1 INT64, gen_a INT64, gen_b INT64, id INT64>, column=$element_table.n#1)
                | |   +-property=id(INT64)
                | +-c1#3 :=
                | | +-GraphGetElementProperty
                | |   +-type=INT64
                | |   +-expr=
                | |   | +-ColumnRef(type=GRAPH_NODE(aml_dml)<c1 INT64, gen_a INT64, gen_b INT64, id INT64>, column=$element_table.n#1)
                | |   +-property=c1(INT64)
                | +-gen_b#4 :=
                | | +-GraphGetElementProperty
                | |   +-type=INT64
                | |   +-expr=
                | |   | +-ColumnRef(type=GRAPH_NODE(aml_dml)<c1 INT64, gen_a INT64, gen_b INT64, id INT64>, column=$element_table.n#1)
                | |   +-property=gen_b(INT64)
                | +-gen_a#5 :=
                |   +-GraphGetElementProperty
                |     +-type=INT64
                |     +-expr=
                |     | +-ColumnRef(type=GRAPH_NODE(aml_dml)<c1 INT64, gen_a INT64, gen_b INT64, id INT64>, column=$element_table.n#1)
                |     +-property=gen_a(INT64)
                +-input_scan=
                  +-GraphRefScan(column_list=[$element_table.n#1])
==

# INSERT into element table with generated columns cannot explicitly insert into generated column.
GRAPH aml_dml
INSERT (n:TestLabelWithGenCols {id: 1, c1: 10, gen_a: 20})
--
ERROR: Cannot insert into property 'gen_a' mapped from a read-only column [at 2:48]
INSERT (n:TestLabelWithGenCols {id: 1, c1: 10, gen_a: 20})
                                               ^
==

#######################################################
# DML Terminality across NEXT
#######################################################

# Chained INSERT statements across NEXT are rejected.
GRAPH aml
INSERT (a:Person {name: "A"}), (b:Person {name: "B"})
NEXT
INSERT (m:Person {name: "M"}), (n:Person {name: "N"})
--
ERROR: INSERT cannot be followed by NEXT and can only have an immediate RETURN as the last statement in a graph query [at 4:1]
INSERT (m:Person {name: "M"}), (n:Person {name: "N"})
^
==

# INSERT followed by MATCH ... RETURN across NEXT is rejected.
GRAPH aml
INSERT (n:Person {name: "N"})
NEXT
MATCH (p)
RETURN p.id
--
ERROR: INSERT cannot be followed by NEXT and can only have an immediate RETURN as the last statement in a graph query [at 4:1]
MATCH (p)
^
==

# INSERT ... RETURN followed by MATCH ... RETURN across NEXT is rejected.
GRAPH aml
INSERT (a:Person {name: "A"})
RETURN a.name
NEXT
MATCH (b:Person)
RETURN b.id
--
ERROR: INSERT cannot be followed by NEXT and can only have an immediate RETURN as the last statement in a graph query [at 5:1]
MATCH (b:Person)
^
==

# MATCH ... INSERT followed by NEXT MATCH ... RETURN is rejected.
GRAPH aml
MATCH (a:Person)
INSERT (b:Person {name: "B"})
NEXT
MATCH (c:Person)
RETURN c.id
--
ERROR: INSERT cannot be followed by NEXT and can only have an immediate RETURN as the last statement in a graph query [at 5:1]
MATCH (c:Person)
^
==

# MATCH ... NEXT INSERT ... NEXT MATCH is rejected.
GRAPH aml
MATCH (a:Person)
RETURN a.name
NEXT
INSERT (b:Person {name: "B"})
NEXT
MATCH (c:Person)
RETURN c.id
--
ERROR: INSERT cannot be followed by NEXT and can only have an immediate RETURN as the last statement in a graph query [at 7:1]
MATCH (c:Person)
^
==

GRAPH aml
INSERT (a:Person {name: "A"}), (b:Person {name: "B"})
NEXT
RETURN 1 AS my_column
--
ERROR: INSERT cannot be followed by NEXT and can only have an immediate RETURN as the last statement in a graph query [at 4:1]
RETURN 1 AS my_column
^

==

