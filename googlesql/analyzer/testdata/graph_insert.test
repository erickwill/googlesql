# Set op before INSERT is allowed.
[{{|no_}}prune_unused_columns]
GRAPH aml
MATCH (n:Account)
RETURN n
UNION all
MATCH (n:Account)
RETURN n

NEXT
INSERT (p:Person {id: 1})-[e:PersonOwnAccount]->(n)
