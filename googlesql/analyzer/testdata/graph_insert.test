# Source node table element key column is non-writable on the node table side,
# but the referenced source key column is exposed as a property: success
# (endpoint key columns only need to be writable on the edge table side).
GRAPH aml_dml
MATCH (src:TestLabelNoWritableKey)
INSERT (src)-[:EdgeFromNoWritableKey]->(dst:TestLabel)
--
GeneralizedQueryStmt
+-query=
  +-GraphTableScan
    +-property_graph=aml_dml
    +-input_scan=
      +-GraphLinearScan
        +-scan_list=
          +-GraphLinearScan
            +-scan_list=
              +-GraphScan
              | +-column_list=[$element_table.src#1]
              | +-input_scan_list=
              | | +-GraphPathScan
              | |   +-column_list=[$element_table.src#1]
              | |   +-input_scan_list=
              | |   | +-GraphNodeScan
              | |   |   +-column_list=[$element_table.src#1]
              | |   |   +-label_expr=
              | |   |   | +-GraphLabel(parse_location=25-47, label=aml_dml.TestLabelNoWritableKey)
              | |   |   +-target_element_table_list=[aml_dml.InsertTestTableNoWritableKey]
              | |   +-head=$element_table.src#1
              | |   +-tail=$element_table.src#1
              | +-input_scan=
              |   +-SingleRowScan
              +-GraphInsertScan
              | +-column_list=$element_table.[src#1, dst#2]
              | +-input_scan=
              | | +-GraphRefScan(column_list=[$element_table.src#1])
              | +-insert_node_list=
              | | +-dst#2 :=
              | |   +-GraphInsertElement
              | |     +-type=GRAPH_NODE(aml_dml)<derived_func_prop STRING, derived_prop STRING, id INT64, measure_prop INT64, readonly_prop STRING, val STRING, val_alias STRING>
              | |     +-label_list=
              | |     | +-GraphLabel(label=aml_dml.TestLabel)
              | |     +-element_table=InsertTestTable
              | +-insert_edge_list=
              | | +-$insert_edge#3 :=
              | |   +-GraphInsertElement
              | |     +-type=GRAPH_EDGE(aml_dml)<edge_dst INT64, edge_src INT64, id INT64>
              | |     +-label_list=
              | |     | +-GraphLabel(label=aml_dml.EdgeFromNoWritableKey)
              | |     +-source_node=
              | |     | +-ColumnRef(type=GRAPH_NODE(aml_dml)<id INT64>, column=$element_table.src#1)
              | |     +-dest_node=
              | |     | +-ColumnRef(type=GRAPH_NODE(aml_dml)<derived_func_prop STRING, derived_prop STRING, id INT64, measure_prop INT64, readonly_prop STRING, val STRING, val_alias STRING>, column=$element_table.dst#2)
              | |     +-element_table=EdgeFromNoWritableKeyTable
              | +-path_element_list=$element_table.[src#1, $insert_edge#3, dst#2]
              +-FinishScan
                +-input_scan=
                  +-GraphRefScan(column_list=$element_table.[src#1, dst#2])
==

