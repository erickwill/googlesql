            +-scan_list=
              +-GraphScan
              | +-column_list=$element_table.[src#1, dst#2]
              | +-input_scan_list=
              | | +-GraphPathScan
              | | | +-column_list=[$element_table.src#1]
              | | | +-input_scan_list=
              | | | | +-GraphNodeScan
              | | | |   +-column_list=[$element_table.src#1]
              | | | |   +-label_expr=
              | | | |   | +-GraphLabel(parse_location=25-34, label=aml_dml.TestLabel)
              | | | |   +-target_element_table_list=[aml_dml.InsertTestTable]
              | | | +-head=$element_table.src#1
              | | | +-tail=$element_table.src#1
              | | +-GraphPathScan
              | |   +-column_list=[$element_table.dst#2]
              | |   +-input_scan_list=
              | |   | +-GraphNodeScan
              | |   |   +-column_list=[$element_table.dst#2]
              | |   |   +-label_expr=
              | |   |   | +-GraphLabel(parse_location=42-51, label=aml_dml.TestLabel)
              | |   |   +-target_element_table_list=[aml_dml.InsertTestTable]
              | |   +-head=$element_table.dst#2
              | |   +-tail=$element_table.dst#2
              | +-input_scan=
              |   +-SingleRowScan
              +-GraphInsertScan
              | +-column_list=$element_table.[src#1, dst#2]
              | +-input_scan=
              | | +-GraphRefScan(column_list=$element_table.[src#1, dst#2])
              | +-insert_edge_list=
              | | +-$insert_edge#3 :=
              | |   +-GraphInsertElement
              | |     +-type=GRAPH_EDGE(aml_dml)<id INT64>
              | |     +-property_list=
              | |     | +-GraphDMLPropertyItem
              | |     |   +-property_name="id"
              | |     |   +-property=id(INT64)
              | |     |   +-property_value=
              | |     |     +-Literal(type=INT64, value=10)
              | |     +-label_list=
              | |     | +-GraphLabel(label=aml_dml.EdgeNoEndpointProps)
              | |     +-source_node=
              | |     | +-ColumnRef(type=GRAPH_NODE(aml_dml)<derived_func_prop STRING, derived_prop STRING, id INT64, measure_prop INT64, readonly_prop STRING, val STRING, val_alias STRING>, column=$element_table.src#1)
              | |     +-dest_node=
              | |     | +-ColumnRef(type=GRAPH_NODE(aml_dml)<derived_func_prop STRING, derived_prop STRING, id INT64, measure_prop INT64, readonly_prop STRING, val STRING, val_alias STRING>, column=$element_table.dst#2)
              | |     +-element_table=EdgeNoEndpointPropsTable
              | +-path_element_list=$element_table.[src#1, $insert_edge#3, dst#2]
              +-FinishScan
                +-input_scan=
                  +-GraphRefScan(column_list=$element_table.[src#1, dst#2])
==

#######################################################
# INSERT property uniqueness and type coercion (assignment)
#######################################################

# Properties: Duplicate property 'name' in INSERT
GRAPH aml
INSERT (n:Person {name: "v1", name: "v2"})
--
ERROR: Duplicate property 'name' is not allowed in INSERT property specification [at 2:31]
INSERT (n:Person {name: "v1", name: "v2"})
                              ^
==

# Properties: Duplicate insertion into the same underlying column via aliased properties
GRAPH aml_dml
INSERT (n:TestLabel {val: "v1", val_alias: "v2"})
--
ERROR: Duplicate insertion into column 'val' [at 2:33]
INSERT (n:TestLabel {val: "v1", val_alias: "v2"})
                                ^
==

# Properties: Duplicate insertion into edge source endpoint key column
GRAPH aml
INSERT (p:Person {id: 1})-[e:PersonOwnAccount {personId: 10}]->(a:Account {id: 2})
--
ERROR: Cannot explicitly specify property 'personId' because it causes duplicate insertion into edge source key column 'personId' [at 2:48]
INSERT (p:Person {id: 1})-[e:PersonOwnAccount {personId: 10}]->(a:Account {id...
                                               ^
==

# Properties: Duplicate insertion into edge destination endpoint key column
GRAPH aml
INSERT (p:Person {id: 1})-[e:PersonOwnAccount {accountId: 20}]->(a:Account {id: 2})
--
ERROR: Cannot explicitly specify property 'accountId' because it causes duplicate insertion into edge destination key column 'accountId' [at 2:48]
INSERT (p:Person {id: 1})-[e:PersonOwnAccount {accountId: 20}]->(a:Account {i...
                                               ^
==

# Properties: Duplicate insertion into edge source endpoint key column
GRAPH aml
MATCH (p:Person {id: 1}), (a:Account {id: 2})
INSERT (p)-[e:PersonOwnAccount {personId: 10}]->(a)
--
ERROR: Cannot explicitly specify property 'personId' because it causes duplicate insertion into edge source key column 'personId' [at 3:33]
INSERT (p)-[e:PersonOwnAccount {personId: 10}]->(a)
                                ^
==

# Properties: Invalid type coercion
GRAPH aml
INSERT (n:Person {name: 1})
--
ERROR: Cannot insert value of type INT64 into property 'name' of type STRING [at 2:25]
INSERT (n:Person {name: 1})
                        ^
==

