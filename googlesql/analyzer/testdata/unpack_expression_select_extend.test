# Unpack a field from the proto value column
FROM TestBcPBValueProtoTable v |> EXTEND **COLUMNS(['value'])
--
QueryStmt
+-output_column_list=
| +-TestBcPBValueProtoTable.value#1 AS value [PROTO<googlesql_test.TestBcPB>]
| +-TestBcPBValueProtoTable.Filename#2 AS Filename [STRING]
| +-TestBcPBValueProtoTable.RowId#3 AS RowId [INT64]
| +-TestBcPBValueProtoTable.value#1 AS value [PROTO<googlesql_test.TestBcPB>]
+-query=
  +-TableScan(column_list=TestBcPBValueProtoTable.[value#1, Filename#2, RowId#3], table=TestBcPBValueProtoTable, column_index_list=[0, 1, 2], alias="v")

[SQLBUILDER_OUTPUT]
FROM
  TestBcPBValueProtoTable
|> SELECT
     TestBcPBValueProtoTable.value AS a_1,
     TestBcPBValueProtoTable.Filename AS a_2,
     TestBcPBValueProtoTable.RowId AS a_3
|> AS testbcpbvalueprototable_4
|> SELECT
     testbcpbvalueprototable_4.a_1 AS value,
     testbcpbvalueprototable_4.a_2 AS Filename,
     testbcpbvalueprototable_4.a_3 AS RowId,
     testbcpbvalueprototable_4.a_1 AS value;

