# Value Table Tests

# Unpack fields
FROM TestStructValueTable |> EXTEND **COLUMNS(['a'])
--
QueryStmt
+-output_column_list=
| +-TestStructValueTable.value#1 AS TestStructValueTable [STRUCT<a INT32, b STRING>]
| +-TestStructValueTable.value#1 AS a [STRUCT<a INT32, b STRING>]
+-query=
  +-TableScan(column_list=[TestStructValueTable.value#1], table=TestStructValueTable, column_index_list=[0])

[SQLBUILDER_OUTPUT]
FROM
  TestStructValueTable
|> SELECT
     TestStructValueTable AS a_1
|> AS teststructvaluetable_2
|> SELECT
     teststructvaluetable_2.a_1 AS TestStructValueTable,
     teststructvaluetable_2.a_1 AS a;
==

# Unpack fields - alias needed
FROM TestStructValueTable v |> EXTEND **COLUMNS(['a'])
