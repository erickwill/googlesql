QueryStmt
+-output_column_list=
| +-TestStructValueTable.value#1 AS v [STRUCT<a INT32, b STRING>]
| +-TestStructValueTable.value#1 AS a [STRUCT<a INT32, b STRING>]
+-query=
  +-TableScan(column_list=[TestStructValueTable.value#1], table=TestStructValueTable, column_index_list=[0], alias="v")

[SQLBUILDER_OUTPUT]
FROM
  TestStructValueTable
|> SELECT
     TestStructValueTable AS a_1
|> AS teststructvaluetable_2
|> SELECT
     teststructvaluetable_2.a_1 AS v,
     teststructvaluetable_2.a_1 AS a;
