# Test JSON_KEYS function.
[language_features=NONE,+JSON_TYPE,+JSON_KEYS_FUNCTION,+NAMED_ARGUMENTS]
SELECT JSON_KEYS(JSON '999'),
       JSON_KEYS(JSON '999', 1),
       JSON_KEYS(JSON '999', 1, mode=>Trim("lax"))
FROM JsonTable;
--

QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [ARRAY<STRING>]
| +-$query.$col2#3 AS `$col2` [ARRAY<STRING>]
| +-$query.$col3#4 AS `$col3` [ARRAY<STRING>]
+-query=
  +-ProjectScan
    +-column_list=$query.[$col1#2, $col2#3, $col3#4]
    +-expr_list=
    | +-$col1#2 :=
    | | +-FunctionCall(GoogleSQL:json_keys(JSON, optional(1) INT64, optional(1) STRING mode) -> ARRAY<STRING>)
    | |   +-Literal(type=JSON, value=999, has_explicit_type=TRUE)
    | |   +-Literal(type=INT64, value=9223372036854775807)
    | |   +-Literal(type=STRING, value="strict")
    | +-$col2#3 :=
    | | +-FunctionCall(GoogleSQL:json_keys(JSON, optional(1) INT64, optional(1) STRING mode) -> ARRAY<STRING>)
    | |   +-Literal(type=JSON, value=999, has_explicit_type=TRUE)
    | |   +-Literal(type=INT64, value=1)
    | |   +-Literal(type=STRING, value="strict")
    | +-$col3#4 :=
    |   +-FunctionCall(GoogleSQL:json_keys(JSON, optional(1) INT64, optional(1) STRING mode) -> ARRAY<STRING>)
    |     +-Literal(type=JSON, value=999, has_explicit_type=TRUE)
    |     +-Literal(type=INT64, value=1)
    |     +-FunctionCall(GoogleSQL:trim(STRING, optional(0) STRING) -> STRING)
    |       +-Literal(type=STRING, value="lax")
    +-input_scan=
      +-TableScan(table=JSONTable)
==

# Test JSON_KEYS with non-const `max_depth`
[language_features=NONE,+JSON_TYPE,+JSON_KEYS_FUNCTION,+JSON_LAX_VALUE_EXTRACTION_FUNCTIONS,+NAMED_ARGUMENTS]
SELECT JSON_KEYS(JSON '1', LAX_INT64(json_col))
FROM JsonTable;
--

QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [ARRAY<STRING>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#2]
    +-expr_list=
    | +-$col1#2 :=
    |   +-FunctionCall(GoogleSQL:json_keys(JSON, optional(1) INT64, optional(1) STRING mode) -> ARRAY<STRING>)
    |     +-Literal(type=JSON, value=1, has_explicit_type=TRUE)
    |     +-FunctionCall(GoogleSQL:lax_int64(JSON) -> INT64)
    |     | +-ColumnRef(type=JSON, column=JSONTable.json_col#1)
    |     +-Literal(type=STRING, value="strict")
    +-input_scan=
      +-TableScan(column_list=[JSONTable.json_col#1], table=JSONTable, column_index_list=[0])
==

# Error: Test JSON_KEYS function with non-const expression for `mode`.
[language_features=NONE,+JSON_TYPE,+JSON_KEYS_FUNCTION,+NAMED_ARGUMENTS]
SELECT JSON_KEYS(JSON '999', mode=>TO_JSON_STRING(json_col))
FROM JsonTable;
--
ERROR: Argument 'mode' to JSON_KEYS must be a constant expression [at 1:30]
SELECT JSON_KEYS(JSON '999', mode=>TO_JSON_STRING(json_col))
                             ^
==

[language_features=NONE,+JSON_TYPE,+MAP_TYPE]
# Calling TO_JSON on a type without JSON conversion defined results in analysis error.
SELECT TO_JSON(MAP_FROM_ARRAY([('a', 1)]));
--
ERROR: Unsupported argument to TO_JSON: MAP<STRING, INT64> does not support conversion to JSON [at 2:8]
SELECT TO_JSON(MAP_FROM_ARRAY([('a', 1)]));
       ^
==

[language_features=MAXIMUM,+JSON_TYPE,+MAP_TYPE]
# A supported type which contains a MAP element is not supported in TO_JSON or TO_JSON_STRING.
SELECT {{TO_JSON|TO_JSON_STRING}}(
  [STRUCT("other-field",
    MAP_FROM_ARRAY([
      ('a', MAP_FROM_ARRAY([('b', 1)]))
    ])
  )]);
--
ALTERNATION GROUP: TO_JSON
--
ERROR: Unsupported argument to TO_JSON: MAP<STRING, MAP<STRING, INT64>> does not support conversion to JSON [at 2:8]
SELECT TO_JSON(
       ^
--
ALTERNATION GROUP: TO_JSON_STRING
--
ERROR: Unsupported argument to TO_JSON_STRING: MAP<STRING, MAP<STRING, INT64>> does not support conversion to JSON [at 2:8]
SELECT TO_JSON_STRING(
       ^
==

[language_features=MAXIMUM,+JSON_TYPE,+MAP_TYPE]
# SAFE_TO_JSON allows unsupported types.
SELECT SAFE_TO_JSON(
  [STRUCT("other-field",
    MAP_FROM_ARRAY([
      ('a', MAP_FROM_ARRAY([('b', 1)]))
    ])
  )]);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [JSON]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:safe_to_json(ARRAY<STRUCT<STRING, MAP<STRING, MAP<STRING, INT64>>>>) -> JSON)
    |     +-FunctionCall(GoogleSQL:$make_array(repeated(1) STRUCT<STRING, MAP<STRING, MAP<STRING, INT64>>>) -> ARRAY<STRUCT<STRING, MAP<STRING, MAP<STRING, INT64>>>>)
    |       +-MakeStruct
    |         +-type=STRUCT<STRING, MAP<STRING, MAP<STRING, INT64>>>
    |         +-field_list=
    |           +-Literal(type=STRING, value="other-field")
    |           +-FunctionCall(GoogleSQL:map_from_array(ARRAY<STRUCT<STRING, MAP<STRING, INT64>>>) -> MAP<STRING, MAP<STRING, INT64>>)
    |             +-FunctionCall(GoogleSQL:$make_array(repeated(1) STRUCT<STRING, MAP<STRING, INT64>>) -> ARRAY<STRUCT<STRING, MAP<STRING, INT64>>>)
    |               +-MakeStruct
    |                 +-type=STRUCT<STRING, MAP<STRING, INT64>>
    |                 +-field_list=
    |                   +-Literal(type=STRING, value="a")
    |                   +-FunctionCall(GoogleSQL:map_from_array(ARRAY<STRUCT<STRING, INT64>>) -> MAP<STRING, INT64>)
    |                     +-Literal(type=ARRAY<STRUCT<STRING, INT64>>, value=[{"b", 1}])
    +-input_scan=
      +-SingleRowScan
==

