[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
WITH
  W AS (
    SELECT
      MeasureTable_Derived.key AS a_1,
      MeasureTable_Derived.measure_derived_sum_price_plus_one_plus_two AS a_2
    FROM
      MeasureTable_Derived
  )
SELECT
  aggregatescan_8.a_5 AS key,
  (aggregatescan_8.a_6) + (aggregatescan_8.a_7) AS a_9
FROM
  (
    SELECT
      withrefscan_3.a_1 AS a_5,
      AGG(withrefscan_3.a_2) AS a_6,
      AGG(withrefscan_4.a_2) AS a_7
    FROM
      (
        SELECT
          withrefscan_3.a_1 AS a_1,
          withrefscan_3.a_2 AS a_2
        FROM
          W AS withrefscan_3
      ) AS withrefscan_3
      INNER JOIN
      (
        SELECT
          withrefscan_4.a_1 AS a_1,
          withrefscan_4.a_2 AS a_2
        FROM
          W AS withrefscan_4
      ) AS withrefscan_4
      ON (withrefscan_3.a_1) = (withrefscan_4.a_1)
    GROUP BY 1
  ) AS aggregatescan_8;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
WITH
  W AS (
    FROM
      MeasureTable_Derived
    |> SELECT
         MeasureTable_Derived.key AS a_1,
         MeasureTable_Derived.measure_derived_sum_price_plus_one_plus_two AS a_2
  )
FROM
  W AS withrefscan_3
|> SELECT
     withrefscan_3.a_1 AS a_1,
     withrefscan_3.a_2 AS a_2
|> AS withrefscan_3
|> INNER JOIN
   (
     FROM
       W AS withrefscan_4
     |> SELECT
          withrefscan_4.a_1 AS a_1,
          withrefscan_4.a_2 AS a_2
     |> AS withrefscan_4
   )
   ON (withrefscan_3.a_1) = (withrefscan_4.a_1)
|> EXTEND
     withrefscan_3.a_1 AS a_5
|> AGGREGATE
     AGG(withrefscan_3.a_2) AS a_6,
     AGG(withrefscan_4.a_2) AS a_7
   GROUP BY a_5
|> AS aggregatescan_8
|> SELECT
     aggregatescan_8.a_5 AS key,
     (aggregatescan_8.a_6) + (aggregatescan_8.a_7) AS a_9;

