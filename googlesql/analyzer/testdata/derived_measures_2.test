==

# Test 3.C: m := n1 + n2 (Shared transitive base measure)
# Definition: measure_derived_sum_price_plus_one_plus_two = measure_derived_sum_price_plus_one + measure_derived_sum_price_plus_two
# where n1 = measure_derived_sum_price_plus_one = b + 1
# and n2 = measure_derived_sum_price_plus_two = b + 2
WITH W AS (SELECT key, measure_derived_sum_price_plus_one_plus_two FROM MeasureTable_Derived)
SELECT W1.key, AGG(W1.measure_derived_sum_price_plus_one_plus_two) + AGG(W2.measure_derived_sum_price_plus_one_plus_two)
FROM W AS W1 JOIN W AS W2 ON W1.key = W2.key
GROUP BY W1.key;
--
QueryStmt
+-output_column_list=
| +-$groupby.key#33 AS key [INT64]
| +-$query.$col2#34 AS `$col2` [INT64]
+-query=
  +-WithScan
    +-column_list=[$groupby.key#33, $query.$col2#34]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="W"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one_plus_two#17]
    |       +-input_scan=
    |         +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one_plus_two#17], table=MeasureTable_Derived, column_index_list=[0, 16])
    +-query=
      +-ProjectScan
        +-column_list=[$groupby.key#33, $query.$col2#34]
        +-expr_list=
        | +-$col2#34 :=
        |   +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
        |     +-ColumnRef(type=INT64, column=$aggregate.$agg1#31)
        |     +-ColumnRef(type=INT64, column=$aggregate.$agg2#32)
        +-input_scan=
          +-AggregateScan
            +-column_list=[$groupby.key#33, $aggregate.$agg1#31, $aggregate.$agg2#32]
            +-input_scan=
            | +-JoinScan
            |   +-column_list=W.[key#27, measure_derived_sum_price_plus_one_plus_two#28, key#29, measure_derived_sum_price_plus_one_plus_two#30]
            |   +-left_scan=
            |   | +-WithRefScan(column_list=W.[key#27, measure_derived_sum_price_plus_one_plus_two#28], with_query_name="W")
            |   +-right_scan=
            |   | +-WithRefScan(column_list=W.[key#29, measure_derived_sum_price_plus_one_plus_two#30], with_query_name="W")
            |   +-join_expr=
            |     +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            |       +-ColumnRef(type=INT64, column=W.key#27)
            |       +-ColumnRef(type=INT64, column=W.key#29)
            +-group_by_list=
            | +-key#33 := ColumnRef(type=INT64, column=W.key#27)
            +-aggregate_list=
              +-$agg1#31 :=
              | +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
