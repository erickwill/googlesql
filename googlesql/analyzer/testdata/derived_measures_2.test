SELECT
  aggregatescan_27.a_23 AS key,
  (aggregatescan_27.a_24) + 1 AS a_28,
  (aggregatescan_27.a_25) + (aggregatescan_27.a_26) AS a_29
FROM
  (
    SELECT
      projectscan_22.a_1 AS a_23,
      SUM(ANY_VALUE(projectscan_22.a_17.referenced_columns.price)
        WHERE
          NOT((projectscan_22.a_17) IS NULL)
        GROUP BY projectscan_22.a_17.key_columns.key) AS a_24,
      SUM(ANY_VALUE(projectscan_22.a_19.referenced_columns.price)
        WHERE
          NOT((projectscan_22.a_19) IS NULL)
        GROUP BY projectscan_22.a_19.key_columns.key) AS a_25,
      SUM(ANY_VALUE(projectscan_22.a_21.referenced_columns.tax)
        WHERE
          NOT((projectscan_22.a_21) IS NULL)
        GROUP BY projectscan_22.a_21.key_columns.key) AS a_26
