SELECT
  tvfscan_1.a_2 AS key,
  AGG(tvfscan_1.a_3) AS a_8,
  AGG(tvfscan_4.a_6) AS a_9
FROM
  (
    SELECT
      tvfscan_1.key AS a_2,
      tvfscan_1.measure_derived_subtotal AS a_3
    FROM
      MEASURETABLE_DERIVED_TVF() AS tvfscan_1
  ) AS tvfscan_1
  INNER JOIN
