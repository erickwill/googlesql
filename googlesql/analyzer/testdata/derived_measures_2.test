| +-$groupby.key#55 AS key [INT64]
| +-$aggregate.$agg1#53 AS `$col2` [INT64]
| +-$aggregate.$agg2#54 AS `$col3` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.key#55, $aggregate.$agg1#53, $aggregate.$agg2#54]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.key#55, $aggregate.$agg1#53, $aggregate.$agg2#54]
        +-input_scan=
        | +-JoinScan
        |   +-column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11, key#27, measure_derived_subtotal#38]
        |   +-join_type=LEFT
        |   +-left_scan=
        |   | +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11], table=MeasureTable_Derived, column_index_list=[0, 10], alias="t1")
        |   +-right_scan=
        |   | +-TableScan(column_list=MeasureTable_Derived.[key#27, measure_derived_subtotal#38], table=MeasureTable_Derived, column_index_list=[0, 11], alias="t2")
        |   +-join_expr=
        |   | +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
        |   |   +-ColumnRef(type=INT64, column=MeasureTable_Derived.key#1)
        |   |   +-ColumnRef(type=INT64, column=MeasureTable_Derived.key#27)
        |   +-has_using=TRUE
        +-group_by_list=
        | +-key#55 := ColumnRef(type=INT64, column=MeasureTable_Derived.key#1)
        +-aggregate_list=
          +-$agg1#53 :=
          | +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
          |   +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11)
          +-$agg2#54 :=
            +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
              +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_subtotal#38)

