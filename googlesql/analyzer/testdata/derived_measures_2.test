[default no_java]
[default language_features=MAXIMUM,+DERIVED_MEASURE]
[default enabled_ast_rewrites=DEFAULTS,+MEASURE_TYPE]
[default show_sqlbuilder_output]

# Test 3.B: m := n + n (Direct derived measure duplication)
# Definition: measure_derived_twice_sum_price_plus_one = measure_derived_sum_price_plus_one + measure_derived_sum_price_plus_one
# where n = measure_derived_sum_price_plus_one = b + 1
WITH W AS (SELECT key, measure_derived_twice_sum_price_plus_one FROM MeasureTable_Derived)
SELECT W1.key, AGG(W1.measure_derived_twice_sum_price_plus_one) + AGG(W2.measure_derived_twice_sum_price_plus_one)
FROM W AS W1 JOIN W AS W2 ON W1.key = W2.key
GROUP BY W1.key;
--
QueryStmt
+-output_column_list=
| +-$groupby.key#33 AS key [INT64]
| +-$query.$col2#34 AS `$col2` [INT64]
+-query=
  +-WithScan
    +-column_list=[$groupby.key#33, $query.$col2#34]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="W"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=MeasureTable_Derived.[key#1, measure_derived_twice_sum_price_plus_one#16]
    |       +-input_scan=
    |         +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_twice_sum_price_plus_one#16], table=MeasureTable_Derived, column_index_list=[0, 15])
    +-query=
      +-ProjectScan
        +-column_list=[$groupby.key#33, $query.$col2#34]
        +-expr_list=
        | +-$col2#34 :=
        |   +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
        |     +-ColumnRef(type=INT64, column=$aggregate.$agg1#31)
        |     +-ColumnRef(type=INT64, column=$aggregate.$agg2#32)
        +-input_scan=
          +-AggregateScan
            +-column_list=[$groupby.key#33, $aggregate.$agg1#31, $aggregate.$agg2#32]
            +-input_scan=
            | +-JoinScan
            |   +-column_list=W.[key#27, measure_derived_twice_sum_price_plus_one#28, key#29, measure_derived_twice_sum_price_plus_one#30]
            |   +-left_scan=
            |   | +-WithRefScan(column_list=W.[key#27, measure_derived_twice_sum_price_plus_one#28], with_query_name="W")
            |   +-right_scan=
            |   | +-WithRefScan(column_list=W.[key#29, measure_derived_twice_sum_price_plus_one#30], with_query_name="W")
            |   +-join_expr=
            |     +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            |       +-ColumnRef(type=INT64, column=W.key#27)
            |       +-ColumnRef(type=INT64, column=W.key#29)
            +-group_by_list=
            | +-key#33 := ColumnRef(type=INT64, column=W.key#27)
            +-aggregate_list=
              +-$agg1#31 :=
              | +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
              |   +-ColumnRef(type=MEASURE<INT64>, column=W.measure_derived_twice_sum_price_plus_one#28)
              +-$agg2#32 :=
                +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
                  +-ColumnRef(type=MEASURE<INT64>, column=W.measure_derived_twice_sum_price_plus_one#30)

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
WITH
  W AS (
    SELECT
      MeasureTable_Derived.key AS a_1,
      MeasureTable_Derived.measure_derived_twice_sum_price_plus_one AS a_2
    FROM
      MeasureTable_Derived
  )
SELECT
  aggregatescan_8.a_5 AS key,
  (aggregatescan_8.a_6) + (aggregatescan_8.a_7) AS a_9
FROM
  (
    SELECT
      withrefscan_3.a_1 AS a_5,
      AGG(withrefscan_3.a_2) AS a_6,
      AGG(withrefscan_4.a_2) AS a_7
    FROM
      (
        SELECT
          withrefscan_3.a_1 AS a_1,
          withrefscan_3.a_2 AS a_2
        FROM
          W AS withrefscan_3
      ) AS withrefscan_3
      INNER JOIN
      (
        SELECT
          withrefscan_4.a_1 AS a_1,
          withrefscan_4.a_2 AS a_2
        FROM
          W AS withrefscan_4
      ) AS withrefscan_4
      ON (withrefscan_3.a_1) = (withrefscan_4.a_1)
    GROUP BY 1
  ) AS aggregatescan_8;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
WITH
  W AS (
    FROM
      MeasureTable_Derived
    |> SELECT
         MeasureTable_Derived.key AS a_1,
         MeasureTable_Derived.measure_derived_twice_sum_price_plus_one AS a_2
  )
FROM
  W AS withrefscan_3
|> SELECT
     withrefscan_3.a_1 AS a_1,
     withrefscan_3.a_2 AS a_2
|> AS withrefscan_3
|> INNER JOIN
   (
     FROM
       W AS withrefscan_4
     |> SELECT
          withrefscan_4.a_1 AS a_1,
          withrefscan_4.a_2 AS a_2
     |> AS withrefscan_4
   )
   ON (withrefscan_3.a_1) = (withrefscan_4.a_1)
|> EXTEND
     withrefscan_3.a_1 AS a_5
|> AGGREGATE
     AGG(withrefscan_3.a_2) AS a_6,
     AGG(withrefscan_4.a_2) AS a_7
   GROUP BY a_5
|> AS aggregatescan_8
|> SELECT
     aggregatescan_8.a_5 AS key,
     (aggregatescan_8.a_6) + (aggregatescan_8.a_7) AS a_9;

