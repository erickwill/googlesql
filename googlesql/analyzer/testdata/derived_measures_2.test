+-output_column_list=
| +-MeasureTable_Derived.key#1 AS key [INT64]
| +-$query.$col2#30 AS `$col2` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[MeasureTable_Derived.key#1, $query.$col2#30]
    +-expr_list=
    | +-$col2#30 :=
    |   +-SubqueryExpr
    |     +-type=INT64
    |     +-subquery_type=SCALAR
    |     +-parameter_list=
    |     | +-ColumnRef(type=INT64, column=MeasureTable_Derived.key#1)
    |     | +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11)
    |     +-subquery=
    |       +-ProjectScan
    |         +-column_list=[$expr_subquery.$col1#29]
    |         +-expr_list=
    |         | +-$col1#29 :=
    |         |   +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |         |     +-ColumnRef(type=INT64, column=MeasureTable_Derived.key#1, is_correlated=TRUE)
    |         |     +-ColumnRef(type=INT64, column=$aggregate.$agg1#28)
    |         +-input_scan=
    |           +-AggregateScan
    |             +-column_list=[$aggregate.$agg1#28]
    |             +-input_scan=
    |             | +-ProjectScan
    |             |   +-column_list=[$subquery1.correlated_measure_derived#27]
    |             |   +-expr_list=
    |             |   | +-correlated_measure_derived#27 := ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11, is_correlated=TRUE)
    |             |   +-input_scan=
    |             |     +-SingleRowScan
    |             +-aggregate_list=
    |               +-$agg1#28 :=
    |                 +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
    |                   +-ColumnRef(type=MEASURE<INT64>, column=$subquery1.correlated_measure_derived#27)
    +-input_scan=
      +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11], table=MeasureTable_Derived, column_index_list=[0, 10], alias="OuterTable")

