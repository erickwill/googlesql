# Multiple scans from the same table with derived measures
SELECT
  t1.key,
  AGG(t1.measure_derived_sum_price_plus_one),
  AGG(t2.measure_derived_sum_price_plus_one)
FROM MeasureTable_Derived t1
JOIN MeasureTable_Derived t2 USING(key)
GROUP BY t1.key;
