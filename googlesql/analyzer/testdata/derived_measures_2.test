          tvfscan_4.key AS a_5,
          tvfscan_4.measure_derived_subtotal AS a_6
        FROM
          MEASURETABLE_DERIVED_TVF() AS tvfscan_4
      ) AS tvfscan_4
  ) AS tvfscan_4
  USING(a_2)
GROUP BY 1;

