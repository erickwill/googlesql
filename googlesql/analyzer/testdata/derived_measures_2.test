SELECT
  measuretable_derived_3.a_1 AS key,
  AGG(measuretable_derived_3.a_2) AS a_8,
  AGG(measuretable_derived_6.a_5) AS a_9
FROM
  (
    SELECT
      MeasureTable_Derived.key AS a_1,
      MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_2
    FROM
      MeasureTable_Derived
  ) AS measuretable_derived_3
  LEFT JOIN
  (
    SELECT
      measuretable_derived_6.a_4 AS a_1,
      measuretable_derived_6.a_5
    FROM
      (
        SELECT
          MeasureTable_Derived.key AS a_4,
          MeasureTable_Derived.measure_derived_subtotal AS a_5
        FROM
          MeasureTable_Derived
      ) AS measuretable_derived_6
  ) AS measuretable_derived_6
  USING(a_1)
GROUP BY 1;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
FROM
  MeasureTable_Derived
|> SELECT
     MeasureTable_Derived.key AS a_1,
     MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_2
|> AS measuretable_derived_3
|> LEFT JOIN
   (
     FROM
       MeasureTable_Derived
     |> SELECT
          MeasureTable_Derived.key AS a_4,
          MeasureTable_Derived.measure_derived_subtotal AS a_5
     |> AS measuretable_derived_6
     |> SELECT
          measuretable_derived_6.a_4 AS a_1,
          measuretable_derived_6.a_5
     |> AS measuretable_derived_6
   )
   USING(a_1)
|> EXTEND
     measuretable_derived_3.a_1 AS a_7
|> AGGREGATE
     AGG(measuretable_derived_3.a_2) AS a_8,
     AGG(measuretable_derived_6.a_5) AS a_9
   GROUP BY a_7
|> AS aggregatescan_10
|> SELECT
     aggregatescan_10.a_7 AS key,
     aggregatescan_10.a_8 AS a_8,
     aggregatescan_10.a_9 AS a_9;

