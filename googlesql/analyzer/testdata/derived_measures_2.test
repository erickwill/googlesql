# Multiple scans from the same TVF with derived measures
SELECT
  t1.key,
  AGG(t1.measure_derived_subtotal),
  AGG(t2.measure_derived_subtotal)
FROM MeasureTable_Derived_TVF() t1
JOIN MeasureTable_Derived_TVF() t2 USING(key)
GROUP BY t1.key;
