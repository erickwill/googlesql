FROM
  MEASURETABLE_DERIVED_TVF() AS tvfscan_1
|> SELECT
     tvfscan_1.key AS a_2,
     STRUCT< referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > (STRUCT< price INT64 >
       (tvfscan_1.price), STRUCT< key INT64 > (tvfscan_1.key)) AS a_3
|> AS projectscan_4
|> SELECT
     projectscan_4.a_2 AS a_2,
     STRUCT< referenced_columns STRUCT< measure_sum_price STRUCT< referenced_columns STRUCT< price INT64 >
     , key_columns STRUCT< key INT64 > > >, key_columns STRUCT< key INT64 > > (STRUCT< measure_sum_price STRUCT<
       referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > > (projectscan_4.a_3), STRUCT<
       key INT64 > (projectscan_4.a_2)) AS a_5
|> AS projectscan_6
|> SELECT
     projectscan_6.a_2 AS a_2,
     projectscan_6.a_5 AS a_5,
     projectscan_6.a_5.referenced_columns.measure_sum_price AS a_7
|> AS projectscan_8
|> EXTEND
     projectscan_8.a_2 AS a_9
|> AGGREGATE
     SUM(ANY_VALUE(projectscan_8.a_7.referenced_columns.price)
       WHERE
         NOT((projectscan_8.a_7) IS NULL)
       GROUP BY projectscan_8.a_7.key_columns.key) AS a_10
   GROUP BY a_9
|> AS aggregatescan_11
|> SELECT
     aggregatescan_11.a_9 AS key,
     (aggregatescan_11.a_10) + 1 AS a_12;
