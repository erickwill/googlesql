# Aggregate a correlated derived measure, but construct it in a way that the
# rewritten subquery needs to reference both the original measure column and
# the corresponding STRUCT column containing information needed to evaluate the
# measure.
SELECT
  key,
  (
    SELECT
      OuterTable.key + AGG(correlated_measure_derived)
    FROM (
      SELECT OuterTable.measure_derived_sum_price_plus_one AS correlated_measure_derived
    )
  )
FROM MeasureTable_Derived AS OuterTable
--
