SELECT Key, **COLUMNS(['Value']), CAST(Key AS STRING) AS key_str FROM KeyValue
--
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.Value#2 AS Value [STRING]
| +-$query.key_str#3 AS key_str [STRING]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.Key#1, KeyValue.Value#2, $query.key_str#3]
    +-expr_list=
    | +-key_str#3 :=
    |   +-Cast(INT64 -> STRING)
    |     +-ColumnRef(type=INT64, column=KeyValue.Key#1)
    +-input_scan=
      +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])

[SQLBUILDER_OUTPUT]
SELECT
  keyvalue_3.a_1 AS Key,
  keyvalue_3.a_2 AS Value,
  CAST(keyvalue_3.a_1 AS STRING) AS key_str
FROM
  (
    SELECT
      KeyValue.Key AS a_1,
      KeyValue.Value AS a_2
    FROM
      KeyValue
  ) AS keyvalue_3;

==

[sql_builder_target_syntax_mode=pipe]
FROM KeyValue |> SELECT Key, **COLUMNS(['Value']), CAST(Key AS STRING) AS key_str

--
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.Value#2 AS Value [STRING]
| +-$pipe_select.key_str#3 AS key_str [STRING]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.Key#1, KeyValue.Value#2, $pipe_select.key_str#3]
    +-expr_list=
    | +-key_str#3 :=
    |   +-Cast(INT64 -> STRING)
    |     +-ColumnRef(type=INT64, column=KeyValue.Key#1)
    +-input_scan=
      +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Key AS a_1,
     KeyValue.Value AS a_2
|> AS keyvalue_3
|> SELECT
     keyvalue_3.a_1 AS Key,
     keyvalue_3.a_2 AS Value,
     CAST(keyvalue_3.a_1 AS STRING) AS key_str;
