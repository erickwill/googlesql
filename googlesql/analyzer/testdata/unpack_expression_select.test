# Unpack fields - alias needed
SELECT **COLUMNS(['a', 'b']) FROM TestStructValueTable v
--
QueryStmt
+-output_column_list=
| +-TestStructValueTable.value#1 AS a [STRUCT<a INT32, b STRING>]
| +-TestStructValueTable.value#1 AS b [STRUCT<a INT32, b STRING>]
+-query=
