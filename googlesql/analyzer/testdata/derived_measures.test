                      STRUCT< referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > (STRUCT< price INT64 >
                        (measuretable_derived_3.a_2), STRUCT< key INT64 > (measuretable_derived_3.a_1)) AS a_4
                    FROM
