|> AS measuretable_derived_4
|> SELECT
     measuretable_derived_4.a_1 AS a_1,
     STRUCT< referenced_columns STRUCT< price INT64, tax INT64 >, key_columns STRUCT< key INT64 > > (STRUCT<
       price INT64, tax INT64 > (measuretable_derived_4.a_2, measuretable_derived_4.a_3), STRUCT< key INT64 >
       (measuretable_derived_4.a_1)) AS a_5
|> AS projectscan_6
|> SELECT
     projectscan_6.a_1 AS a_1,
     STRUCT< referenced_columns STRUCT< measure_sum_price STRUCT< referenced_columns STRUCT< price INT64,
     tax INT64 >, key_columns STRUCT< key INT64 > >, measure_sum_tax STRUCT< referenced_columns STRUCT< price INT64,
     tax INT64 >, key_columns STRUCT< key INT64 > > >, key_columns STRUCT< key INT64 > > (STRUCT< measure_sum_price STRUCT<
       referenced_columns STRUCT< price INT64, tax INT64 >, key_columns STRUCT< key INT64 > >, measure_sum_tax STRUCT<
       referenced_columns STRUCT< price INT64, tax INT64 >, key_columns STRUCT< key INT64 > > > (projectscan_6.a_5,
         projectscan_6.a_5), STRUCT< key INT64 > (projectscan_6.a_1)) AS a_7
|> AS projectscan_8
|> SELECT
     projectscan_8.a_1 AS a_1,
     projectscan_8.a_7 AS a_7,
     projectscan_8.a_7.referenced_columns.measure_sum_price AS a_9
|> AS projectscan_10
|> SELECT
     projectscan_10.a_1 AS a_1,
     projectscan_10.a_7 AS a_7,
     projectscan_10.a_9 AS a_9,
     projectscan_10.a_7.referenced_columns.measure_sum_tax AS a_11
|> AS projectscan_12
|> EXTEND
     projectscan_12.a_1 AS a_13
|> AGGREGATE
     SUM(ANY_VALUE(projectscan_12.a_9.referenced_columns.price)
       WHERE
         NOT((projectscan_12.a_9) IS NULL)
       GROUP BY projectscan_12.a_9.key_columns.key) AS a_14,
     SUM(ANY_VALUE(projectscan_12.a_11.referenced_columns.tax)
       WHERE
         NOT((projectscan_12.a_11) IS NULL)
       GROUP BY projectscan_12.a_11.key_columns.key) AS a_15
   GROUP BY a_13
|> AS aggregatescan_16
|> SELECT
     aggregatescan_16.a_13 AS key,
     (aggregatescan_16.a_14) + (aggregatescan_16.a_15) AS a_17;
