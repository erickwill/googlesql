[default no_java]
[default language_features=MAXIMUM,+DERIVED_MEASURE]
[default enabled_ast_rewrites=DEFAULTS,+MEASURE_TYPE]
[default show_sqlbuilder_output]

# Basic Single Dependency
# Scenario: AGG(measure_derived_sum_price_plus_one) where measure_derived_sum_price_plus_one = measure_sum_price + 1.
SELECT
  key,
  AGG(measure_derived_sum_price_plus_one)
FROM MeasureTable_Derived GROUP BY key;
--
QueryStmt
+-output_column_list=
| +-$groupby.key#28 AS key [INT64]
| +-$aggregate.$agg1#27 AS `$col2` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.key#28, $aggregate.$agg1#27]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.key#28, $aggregate.$agg1#27]
        +-input_scan=
        | +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11], table=MeasureTable_Derived, column_index_list=[0, 10])
        +-group_by_list=
        | +-key#28 := ColumnRef(type=INT64, column=MeasureTable_Derived.key#1)
        +-aggregate_list=
          +-$agg1#27 :=
            +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
              +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_sum_price_plus_one#11)

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
SELECT
  measuretable_derived_3.a_1 AS key,
  AGG(measuretable_derived_3.a_2) AS a_5
FROM
  (
    SELECT
      MeasureTable_Derived.key AS a_1,
      MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_2
    FROM
      MeasureTable_Derived
  ) AS measuretable_derived_3
GROUP BY 1;

