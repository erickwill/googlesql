[SQLBUILDER_OUTPUT]
FROM
  MeasureTable_Derived
|> SELECT
     MeasureTable_Derived.key AS a_1,
     MeasureTable_Derived.measure_derived_sum_price_plus_one AS a_2
|> AS measuretable_derived_3
|> EXTEND
     measuretable_derived_3.a_1 AS a_4
|> AGGREGATE
     AGG(measuretable_derived_3.a_2) AS a_5
   GROUP BY a_4
|> AS aggregatescan_6
|> SELECT
     aggregatescan_6.a_4 AS key,
     aggregatescan_6.a_5 AS a_5;

