# Multiple references to the same WITH alias (Self-Join)
WITH t AS (
  SELECT key, measure_derived_sum_price_plus_one AS m FROM MeasureTable_Derived
)
SELECT t1.key, AGG(t1.m), AGG(t2.m)
FROM t t1 JOIN t t2 ON t1.key = t2.key
GROUP BY t1.key;
