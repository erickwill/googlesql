                          MeasureTable_Derived.price AS a_2,
                          MeasureTable_Derived.tax AS a_3
                        FROM
                          MeasureTable_Derived
                      ) AS measuretable_derived_4
                  ) AS projectscan_6
              ) AS projectscan_8
          ) AS projectscan_10
      ) AS projectscan_12
    GROUP BY 1
  ) AS aggregatescan_16;

