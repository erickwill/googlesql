# Nested correlation with Derived Measure
SELECT key, (
  SELECT (
    SELECT OuterTable.key + AGG(OuterTable.measure_derived_sum_price_plus_one)
    FROM MeasureTable_SingleKey
  )
  FROM MeasureTable_SingleKey
)
FROM MeasureTable_Derived AS OuterTable;
