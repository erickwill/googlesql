# Nested Derived Measures
# Scenario: AGG(measure_derived_order_total) where measure_derived_order_total = measure_derived_subtotal + measure_sum_shipping.
SELECT
  key,
  AGG(measure_derived_order_total)
FROM MeasureTable_Derived GROUP BY key;
