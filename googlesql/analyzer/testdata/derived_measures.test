# Correlated Subquery in WHERE Clause referencing Derived Measure
SELECT key FROM MeasureTable_Derived AS t1
WHERE (
  SELECT AGG(t1.measure_derived_sum_price_plus_one) FROM MeasureTable_SingleKey
) > 10;
