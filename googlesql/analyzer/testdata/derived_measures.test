SELECT
  projectscan_18.a_12 AS key,
  projectscan_18.a_16 AS a_16
FROM
  (
    SELECT
      aggregatescan_15.a_12 AS a_12,
      (aggregatescan_15.a_13) + 1 AS a_16,
      (aggregatescan_15.a_14) + 1 AS a_17
    FROM
      (
        SELECT
          projectscan_11.a_1 AS a_12,
          SUM(ANY_VALUE(projectscan_11.a_8.referenced_columns.price)
            WHERE
              NOT((projectscan_11.a_8) IS NULL)
            GROUP BY projectscan_11.a_8.key_columns.key) AS a_13,
          SUM(ANY_VALUE(projectscan_11.a_10.referenced_columns.price)
            WHERE
              NOT((projectscan_11.a_10) IS NULL)
            GROUP BY projectscan_11.a_10.key_columns.key) AS a_14
        FROM
          (
            SELECT
              projectscan_9.a_1 AS a_1,
              projectscan_9.a_6 AS a_6,
              projectscan_9.a_8 AS a_8,
              projectscan_9.a_6.referenced_columns.measure_sum_price AS a_10
            FROM
              (
                SELECT
                  projectscan_7.a_1 AS a_1,
                  projectscan_7.a_6 AS a_6,
                  projectscan_7.a_6.referenced_columns.measure_sum_price AS a_8
                FROM
                  (
                    SELECT
                      projectscan_5.a_1 AS a_1,
                      STRUCT< referenced_columns STRUCT< measure_sum_price STRUCT< referenced_columns STRUCT< price INT64 >
                      , key_columns STRUCT< key INT64 > > >, key_columns STRUCT< key INT64 > > (STRUCT< measure_sum_price STRUCT<
                        referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > > (projectscan_5.a_4), STRUCT<
                        key INT64 > (projectscan_5.a_1)) AS a_6
                    FROM
                      (
                        SELECT
                          measuretable_derived_3.a_1 AS a_1,
                          STRUCT< referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > (STRUCT< price INT64 >
                            (measuretable_derived_3.a_2), STRUCT< key INT64 > (measuretable_derived_3.a_1)) AS a_4
                        FROM
                          (
                            SELECT
                              MeasureTable_Derived.key AS a_1,
                              MeasureTable_Derived.price AS a_2
                            FROM
                              MeasureTable_Derived
                          ) AS measuretable_derived_3
                      ) AS projectscan_5
                  ) AS projectscan_7
              ) AS projectscan_9
          ) AS projectscan_11
        GROUP BY 1
      ) AS aggregatescan_15
  ) AS projectscan_18
WHERE
  (projectscan_18.a_17) > 10;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
FROM
  MeasureTable_Derived
|> SELECT
     MeasureTable_Derived.key AS a_1,
     MeasureTable_Derived.price AS a_2
|> AS measuretable_derived_3
|> SELECT
     measuretable_derived_3.a_1 AS a_1,
     STRUCT< referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > (STRUCT< price INT64 >
       (measuretable_derived_3.a_2), STRUCT< key INT64 > (measuretable_derived_3.a_1)) AS a_4
|> AS projectscan_5
|> SELECT
     projectscan_5.a_1 AS a_1,
     STRUCT< referenced_columns STRUCT< measure_sum_price STRUCT< referenced_columns STRUCT< price INT64 >
     , key_columns STRUCT< key INT64 > > >, key_columns STRUCT< key INT64 > > (STRUCT< measure_sum_price STRUCT<
       referenced_columns STRUCT< price INT64 >, key_columns STRUCT< key INT64 > > > (projectscan_5.a_4), STRUCT<
       key INT64 > (projectscan_5.a_1)) AS a_6
|> AS projectscan_7
|> SELECT
     projectscan_7.a_1 AS a_1,
     projectscan_7.a_6 AS a_6,
     projectscan_7.a_6.referenced_columns.measure_sum_price AS a_8
|> AS projectscan_9
|> SELECT
     projectscan_9.a_1 AS a_1,
     projectscan_9.a_6 AS a_6,
     projectscan_9.a_8 AS a_8,
     projectscan_9.a_6.referenced_columns.measure_sum_price AS a_10
|> AS projectscan_11
|> EXTEND
     projectscan_11.a_1 AS a_12
|> AGGREGATE
     SUM(ANY_VALUE(projectscan_11.a_8.referenced_columns.price)
       WHERE
         NOT((projectscan_11.a_8) IS NULL)
       GROUP BY projectscan_11.a_8.key_columns.key) AS a_13,
     SUM(ANY_VALUE(projectscan_11.a_10.referenced_columns.price)
       WHERE
         NOT((projectscan_11.a_10) IS NULL)
       GROUP BY projectscan_11.a_10.key_columns.key) AS a_14
   GROUP BY a_12
|> AS aggregatescan_15
|> SELECT
     aggregatescan_15.a_12 AS a_12,
     (aggregatescan_15.a_13) + 1 AS a_16,
     (aggregatescan_15.a_14) + 1 AS a_17
|> AS projectscan_18
|> WHERE
     (projectscan_18.a_17) > 10
|> SELECT
     projectscan_18.a_12 AS key,
     projectscan_18.a_16 AS a_16;
