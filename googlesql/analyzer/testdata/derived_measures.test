+-output_column_list=
| +-$groupby.key#28 AS key [INT64]
| +-$aggregate.$agg1#27 AS `$col2` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.key#28, $aggregate.$agg1#27]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.key#28, $aggregate.$agg1#27]
        +-input_scan=
        | +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_order_total#13], table=MeasureTable_Derived, column_index_list=[0, 12])
        +-group_by_list=
        | +-key#28 := ColumnRef(type=INT64, column=MeasureTable_Derived.key#1)
        +-aggregate_list=
          +-$agg1#27 :=
            +-AggregateFunctionCall(GoogleSQL:AGG(MEASURE<INT64>) -> INT64)
              +-ColumnRef(type=MEASURE<INT64>, column=MeasureTable_Derived.measure_derived_order_total#13)

