==

# Group 3: Branching Propagation (via Join of WITH)
# Test 3.A: m := b + b (Direct base measure duplication)
# Definition: measure_derived_twice_sum_price = measure_sum_price + measure_sum_price
WITH W AS (SELECT key, measure_derived_twice_sum_price FROM MeasureTable_Derived)
SELECT W1.key, AGG(W1.measure_derived_twice_sum_price) + AGG(W2.measure_derived_twice_sum_price)
FROM W AS W1 JOIN W AS W2 ON W1.key = W2.key
GROUP BY W1.key;
