        +-column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11]
        +-input_scan=
        | +-TableScan(column_list=MeasureTable_Derived.[key#1, measure_derived_sum_price_plus_one#11], table=MeasureTable_Derived, column_index_list=[0, 10], alias="t1")
        +-filter_expr=
