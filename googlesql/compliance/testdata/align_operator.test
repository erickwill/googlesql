[name=align_metrics_expression_combining_estimator_functions]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  OUTPUT WITHIN RANGE FROM TIMESTAMP '2020-01-01 00:01:00+00' TO TIMESTAMP '2020-01-01 00:02:30+00'
  PARTITION BY borg_job
  METRICS
    MIN(gcu) WITHIN (1 PERIOD PRECEDING) + MAX(gcu) WITHIN (1 PERIOD PRECEDING) AS minmax
);
