[name=align_metrics_within_ranges_using_absolute_timestamp_bounds]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN TIMESTAMP '2020-01-01 00:00:00+00'
  OUTPUT WITHIN RANGE FROM TIMESTAMP '2020-01-01 00:01:00+00' TO TIMESTAMP '2020-01-01 00:02:00+00'
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (RANGE FROM TIMESTAMP '2020-01-01 00:00:00+00') AS sum_requests_1,
    SUM(requests) WITHIN (RANGE TO TIMESTAMP '2020-01-01 00:02:00+00') AS sum_requests_2,
    SUM(requests) WITHIN (RANGE FROM TIMESTAMP '2020-01-01 00:00:00+00' TO TIMESTAMP '2020-01-01 00:02:00+00') AS sum_requests_3
);
--
ARRAY<STRUCT<borg_job STRING,
             sum_requests_1 INT64,
             sum_requests_2 INT64,
             sum_requests_3 INT64,
             ts TIMESTAMP>>
[unknown order:{
                 "job_B",
                 NULL,
                 10000,
                 10000,
                 2020-01-01 00:01:00+00
               },
               {
                 "job_A",
                 111,
                 1000,
                 1111,
                 2020-01-01 00:01:00+00
               }]
==

# PERIOD multipliers can be fractional (e.g. 0.5 PERIOD with a 1-minute period = 30 seconds).
[name=align_metrics_fractional_period_multiplier]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (0.5 PERIOD PRECEDING) AS sum_req
);
--
ARRAY<STRUCT<borg_job STRING, sum_req INT64, ts TIMESTAMP>>[unknown order:
  {
    "job_B",
    10000,
    2020-01-01 00:02:00+00
  },
  {
    "job_A",
    110,
    2020-01-01 00:01:00+00
  },
  {
    "job_B",
    100000,
    2020-01-01 00:03:00+00
  }
]
==

[name=align_metrics_zero_period_multiplier_error]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (0.0 PERIOD PRECEDING) AS sum_req
);
--
ERROR: generic::out_of_range: ALIGN PERIOD multiplier must be positive
==

[name=align_metrics_negative_period_multiplier_error]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (-1 PERIOD PRECEDING) AS sum_req
);
--
ERROR: generic::out_of_range: ALIGN PERIOD multiplier must be positive
==

[name=align_metrics_nan_period_multiplier_error]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (CAST('NaN' AS DOUBLE) PERIOD PRECEDING) AS sum_req
