ARRAY<STRUCT<borg_job STRING,
             sum_requests_1 INT64,
             sum_requests_2 INT64,
             sum_requests_3 INT64,
             sum_requests_4 INT64,
             sum_requests_5 INT64,
             ts TIMESTAMP>>
[unknown order:{
                 "job_A",
                 1111,
                 1111,
                 1111,
                 1000,
                 1111,
                 2020-01-01 00:00:00+00
               },
               {
                 "job_A",
