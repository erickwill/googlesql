[name=align_metrics_aligned_timestamp_reference_in_estimator_function_call]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  OUTPUT WITHIN RANGE FROM TIMESTAMP '2020-01-01 00:02:00+00' TO TIMESTAMP '2020-01-01 00:03:00+00'
  PARTITION BY borg_job
  METRICS
    MAX(TIMESTAMP_ADD(ts, INTERVAL 5 SECOND)) WITHIN (1 PERIOD PRECEDING) AS timestamp_metric,
    MAX(TIMESTAMP_ADD(aligned_timestamp, INTERVAL 5 SECOND)) WITHIN (1 PERIOD PRECEDING) AS aligned_timestamp_metric
);
--
ARRAY<STRUCT<
        borg_job STRING,
        timestamp_metric TIMESTAMP,
        aligned_timestamp_metric TIMESTAMP,
        ts TIMESTAMP
      >>
[unknown order:{
                 "job_B",
                 2020-01-01 00:02:05+00,
                 2020-01-01 00:02:05+00,
                 2020-01-01 00:02:00+00
               },
               {
                 "job_A",
                 2020-01-01 00:01:35+00,
                 2020-01-01 00:02:05+00,
                 2020-01-01 00:02:00+00
               }]
==

# The identifier `timestamp` can be used to refer to the timestamp expression
# even if a different alias is provided.
[name=align_timestamp_expr_alias_and_timestamp_identifier_in_estimator_function_call]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP TIMESTAMP_ADD(ts, INTERVAL 1 DAY) as timestamp_alias
  PERIOD INTERVAL 1 MINUTE
  OUTPUT WITHIN RANGE FROM TIMESTAMP '2020-01-02 00:01:00+00' TO TIMESTAMP '2020-01-02 00:03:00+00'
  PARTITION BY borg_job
  METRICS
    MAX(TIMESTAMP_ADD(timestamp, INTERVAL 5 SECOND)) WITHIN (1 PERIOD PRECEDING) AS m1,
    MAX(TIMESTAMP_ADD(timestamp_alias, INTERVAL 5 SECOND)) WITHIN (1 PERIOD PRECEDING) AS m2,
    MAX(TIMESTAMP_ADD(aligned_timestamp, INTERVAL 5 SECOND)) WITHIN (1 PERIOD PRECEDING) AS m3
);
--
ARRAY<STRUCT<
        borg_job STRING,
        m1 TIMESTAMP,
        m2 TIMESTAMP,
        m3 TIMESTAMP,
        timestamp_alias TIMESTAMP
      >>
[unknown order:{
                 "job_A",
                 2020-01-02 00:01:35+00,
                 2020-01-02 00:01:35+00,
                 2020-01-02 00:02:05+00,
                 2020-01-02 00:02:00+00
               },
               {
                 "job_A",
                 2020-01-02 00:01:05+00,
                 2020-01-02 00:01:05+00,
                 2020-01-02 00:01:05+00,
                 2020-01-02 00:01:00+00
               },
               {
                 "job_B",
                 2020-01-02 00:02:05+00,
                 2020-01-02 00:02:05+00,
                 2020-01-02 00:02:05+00,
                 2020-01-02 00:02:00+00
               }]
==

[name=align_partition_col_and_expr_reference_in_estimator_expression]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  OUTPUT WITHIN RANGE FROM TIMESTAMP '2020-01-01 00:01:00+00' TO TIMESTAMP '2020-01-01 00:02:30+00'
  PARTITION BY borg_job, CONCAT(borg_job, "_", borg_cell) AS job_cell
  METRICS
    SUM(requests * IF(borg_job = 'job_A', 2, 1)) WITHIN (1 PERIOD PRECEDING) AS weighted_requests,
    CONCAT(job_cell, "_", CAST(COUNT(requests) WITHIN (1 PERIOD PRECEDING) AS STRING)) AS concat_requests
);
--
ARRAY<STRUCT<
        borg_job STRING,
        job_cell STRING,
        weighted_requests INT64,
        concat_requests STRING,
        ts TIMESTAMP
      >>
[unknown order:{
                 "job_A",
                 "job_A_cell2",
                 2000,
                 "job_A_cell2_1",
                 2020-01-01 00:02:00+00
               },
               {
                 "job_A",
                 "job_A_cell1",
                 222,
                 "job_A_cell1_3",
                 2020-01-01 00:01:00+00
               },
               {
                 "job_B",
                 "job_B_cell1",
                 10000,
                 "job_B_cell1_1",
                 2020-01-01 00:02:00+00
               }]
==

[name=align_correlated_references_in_various_expressions]
SELECT * FROM (
  SELECT INTERVAL 1 MINUTE AS corelated_interval,
         TIMESTAMP('2020-01-01 00:00:01+00') AS corelated_ts,
         1 AS corelated_metric_col,
         "xyz" AS correlated_key)
WHERE EXISTS(SELECT * FROM TimeseriesData ALIGN (
    TIMESTAMP ts + corelated_interval
    PERIOD corelated_interval
    ORIGIN corelated_ts
    PARTITION BY CONCAT(correlated_key, "_", borg_job) AS pk
    METRICS corelated_ts + SUM(corelated_interval) WITHIN (INTERVAL corelated_metric_col MINUTE PRECEDING) AS m1,
            LENGTH(FORMAT_TIMESTAMP("%b %Y", corelated_ts)) + SUM(corelated_metric_col + requests) WITHIN () AS m2
))
--
ARRAY<STRUCT<
        corelated_interval INTERVAL,
        corelated_ts TIMESTAMP,
        corelated_metric_col INT64,
        correlated_key STRING
      >>
[{
   0-0 0 0:1:0,
   2020-01-01 00:00:01+00,
   1,
   "xyz"
 }]
==

# ALIGN prunes output rows in which all metric values evaluate to NULL. In this
# test, aligned timestamp 00:03:00 has no data in its within windows, so both
# metrics evaluate to NULL and the row is omitted from the output. Aligned
# timestamps where at least one of the metrics is not NULL are retained.
[name=align_output_null_pruning]
WITH SparseTimeseriesData AS (
  SELECT TIMESTAMP '2020-01-01 00:00:20+00' AS ts, 10 AS requests, 1.0 AS gcu, 'job_A' AS borg_job
  UNION ALL
  SELECT TIMESTAMP '2020-01-01 00:03:20+00' AS ts, 20 AS requests, 2.0 AS gcu, 'job_A' AS borg_job
)
SELECT * FROM SparseTimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (1 PERIOD PRECEDING) AS sparse_requests,
    AVG(gcu) WITHIN (2 PERIOD PRECEDING) AS sparse_gcu
);
--
ARRAY<STRUCT<
        borg_job STRING,
        sparse_requests INT64,
        sparse_gcu DOUBLE,
        ts TIMESTAMP
      >>
[unknown order:{
                 "job_A",
                 NULL,
                 1,
                 2020-01-01 00:02:00+00
               },
               {
                 "job_A",
                 NULL,
                 2,
                 2020-01-01 00:05:00+00
               },
               {
                 "job_A",
                 10,
                 1,
                 2020-01-01 00:01:00+00
               },
               {
                 "job_A",
                 20,
                 2,
                 2020-01-01 00:04:00+00
               }]
==

# Default timezone in reference implementation is "America/Los_Angeles".
# A timestamp without an explicit timezone is interpreted to be in "-08" or
# "-07" depending whether the date falls in standard or daylight savings time.
# The UTC equivalent of the timestamps in the input data are:
#   2020-01-01 08:01:00+00
#   2020-01-01 02:01:00+00
#   2019-12-31 22:01:00+00
# The timestamps in the result are always rendered in UTC/+00.
[name=align_timeseries_with_multiple_timezones]
WITH TimeseriesMultipleTimezones AS (
  SELECT TIMESTAMP '2020-01-01 00:01:00' AS ts, 100 AS requests, 10.0 AS gcu, 'job_B' AS borg_job, 'cell1' AS borg_cell
  UNION ALL
  SELECT TIMESTAMP '2020-01-01 00:01:00-02' AS ts, 200 AS requests, 20.0 AS gcu, 'job_B' AS borg_job, 'cell1' AS borg_cell
  UNION ALL
  SELECT TIMESTAMP '2020-01-01 00:01:00+02' AS ts, 300 AS requests, 30.0 AS gcu, 'job_B' AS borg_job, 'cell2' AS borg_cell
)
SELECT * FROM TimeseriesMultipleTimezones ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 HOUR
  ORIGIN EPOCH
);
--
ARRAY<STRUCT<ts TIMESTAMP>>[unknown order:
  {2019-12-31 23:00:00+00},
  {2020-01-01 00:00:00+00},
  {2020-01-01 01:00:00+00},
  {2020-01-01 02:00:00+00},
  {2020-01-01 03:00:00+00},
  {2020-01-01 04:00:00+00},
  {2020-01-01 05:00:00+00},
  {2020-01-01 06:00:00+00},
  {2020-01-01 07:00:00+00},
  {2020-01-01 08:00:00+00}
]
