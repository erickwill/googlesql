                 110000,
                 110000,
                 100000,
                 110000,
                 2020-01-01 00:01:00+00
               },
               {
                 "job_B",
                 NULL,
                 NULL,
                 100000,
                 NULL,
                 110000,
                 2020-01-01 00:03:00+00
               },
               {
                 "job_A",
                 1111,
                 1111,
                 1111,
                 1111,
                 1111,
                 2019-12-31 23:59:00+00
               },
               {
                 "job_A",
                 1000,
                 1000,
                 1111,
                 NULL,
                 1111,
                 2020-01-01 00:01:00+00
