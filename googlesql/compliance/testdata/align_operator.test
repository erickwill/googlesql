# Test case with possible WITHIN ranges having the upper bound as UNBOUNDED
# FOLLOWING: (lower_bound, +inf).
[name=align_metrics_unbounded_following_upper_bound]
SELECT * FROM TimeseriesData ALIGN (
  TIMESTAMP ts
  PERIOD INTERVAL 1 MINUTE
  ORIGIN EPOCH
  PARTITION BY borg_job
  METRICS
    SUM(requests) WITHIN (UNBOUNDED FOLLOWING) AS sum_requests_1,
    SUM(requests) WITHIN (RANGE TO UNBOUNDED FOLLOWING) AS sum_requests_2,
    SUM(requests) WITHIN (RANGE FROM INTERVAL 1 MINUTE PRECEDING TO UNBOUNDED FOLLOWING) AS sum_requests_3,
    SUM(requests) WITHIN (RANGE FROM INTERVAL 1 MINUTE FOLLOWING TO UNBOUNDED FOLLOWING) AS sum_requests_4,
    SUM(requests) WITHIN (RANGE FROM UNBOUNDED PRECEDING TO UNBOUNDED FOLLOWING) AS sum_requests_5
);
